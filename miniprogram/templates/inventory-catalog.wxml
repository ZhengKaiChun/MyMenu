<view class="pantry-fixed-page">
<view class="pantry-fixed-head"><view class="pantry-title-row"><view class="h2">{{personal?'个人食材库':'小家食材库'}}</view><button wx:if="{{!personal && canMatch}}" hover-class="none" class="match-header-btn" bindtap="go" data-page="match"><g-icon name="basket" size="18"/><text>看看能做啥</text><text>↗</text></button></view><view class="row pantry-total"><text>共 {{totalCount}} 种食材</text><text wx:if="{{personal}}" class="caption">只属于你自己</text><button wx:else hover-class="none" class="text-btn" bindtap="showImport">从个人食材导入 ↙</button></view><view class="search row"><g-icon name="search" size="20"/><input placeholder="找找冰箱里的食材" value="{{query}}" bindinput="search"/></view><scroll-view scroll-x class="category-tabs"><view><button hover-class="none" wx:for="{{categoryTabs}}" wx:key="id" bindtap="categoryTab" data-id="{{item.id}}" class="{{activeCategory===item.id?'active':''}}">{{item.name}}<text>{{item.count}}</text></button></view></scroll-view><view wx:if="{{activeCategory==='肉类'}}" class="meat-fixed-tabs"><button hover-class="none" wx:for="{{meatTypes}}" wx:key="*this" bindtap="meatTab" data-type="{{item}}" class="{{meatType===item?'active':''}}">{{item}}</button></view></view>
<view wx:if="{{error}}" class="error-tip" bindtap="retry">{{error}}</view><scroll-view scroll-y class="pantry-list-scroll"><view class="pantry-list-content"><view wx:for="{{items}}" wx:key="id" class="card row pantry-item"><view class="avatar"><g-icon name="{{item.icon}}" size="29"/></view><view class="grow"><view class="h4 strong">{{item.name}}</view><text class="caption copy small-text">{{item.quantity}} {{item.unit}} · {{item.category}}{{item.meatType?' / '+item.meatType:''}}</text></view><button hover-class="none" class="text-btn" data-id="{{item.id}}" bindtap="edit">编辑</button></view><view wx:if="{{!items.length}}" class="empty"><g-icon name="basket" size="42"/><view>这格冰箱还空着</view><text class="caption">换个分类，或添加几样食材吧</text></view></view></scroll-view></view>