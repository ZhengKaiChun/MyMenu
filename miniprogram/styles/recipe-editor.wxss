/* Editor: a recipe notebook, with obvious actions and centered empty media frames. */
.page-editDish {
  padding-top: 12px;
}
.page-editDish > .h2 {
  font-size: 25px;
  margin: 0 0 15px;
}
.cover-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 18px;
  margin-bottom: 8px;
}
.cover-heading .form-label {
  margin: 0;
}
.cover-heading .text-btn {
  font-size: 10px;
}
.page-editDish .upload {
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  min-height: 148px;
  padding: 0 !important;
  line-height: 1.5;
  border: 1px dashed #cbb48e;
  border-radius: 15px;
  background: #f6ecd9;
}
.upload-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 9px;
  width: 100%;
  min-height: 148px;
  color: #9e8058;
  font-size: 12px;
}
.page-editDish .step-photo {
  width: 100%;
  height: 190px;
  display: block;
}
.dish-preferences {
  margin: 18px 0 5px;
  padding: 14px;
  background: #fff6e6;
  border: 1px solid #e4d1b0;
  border-radius: 17px;
}
.featured-toggle {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 12px;
  padding-bottom: 13px;
  border-bottom: 1px dashed #e4d1b0;
}
.featured-toggle > view > text {
  display: block;
  font-size: 12px;
}
.featured-toggle > view > text:last-child {
  font-size: 10px;
  color: #ab8d65;
  margin-top: 3px;
}
.featured-toggle switch {
  transform: scale(0.75);
  transform-origin: right center;
}
.spice-heading {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin: 12px 0 9px;
  font-size: 12px;
}
.spice-heading > text:last-child {
  font-size: 9px;
  color: #ac9475;
}
.spice-options {
  display: flex;
  gap: 8px;
}
.spice-options button {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 4px;
  padding: 7px 5px !important;
  border: 1px solid #e3cbb6;
  border-radius: 10px;
  background: #fffcf6;
  font-size: 11px;
}
.spice-options button.active {
  background: #f5dfd3;
  border-color: #cb9176;
  color: #ab563d;
}
.page-editDish .section-title {
  margin: 23px 0 11px;
}
.add-row-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 33px;
  padding: 5px 11px !important;
  border: 1px solid #c7aa82;
  border-radius: 10px;
  background: #efe0c4;
  color: #855f3c;
  font-size: 11px;
}
.add-step-btn {
  width: 100% !important;
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 45px;
  background: #eee4cf;
  border: 1px dashed #ba9a6d;
  border-radius: 13px;
  margin: 15px 0 !important;
  font-size: 13px;
  font-weight: 600;
  color: #8d663f;
}
.page-editDish .step {
  padding: 13px;
  margin: 14px 0;
  background: #fffaf0;
  border: 1px solid #e5d3b5;
  border-radius: 17px;
}
.page-editDish .step .upload {
  margin-top: 11px;
}
.page-editDish .step .row > .text-btn {
  font-size: 10px;
}

.page-editDish input.input {
  height: 48px;
  line-height: 48px;
  padding: 0 13px;
}
.page-editDish > .form-label {
  margin-top: 16px;
  margin-bottom: 8px;
}
