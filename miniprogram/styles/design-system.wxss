page {
  --paper: #fffcf6;
  --white: #fffefa;
  --ink: #422d26;
  --muted: #8d7969;
  --line: #e9dfd1;
  --orange: #b74f37;
  --pink: #f6d8ca;
  --sage: #617858;
  --green: #edf1e5;
  --sand: #f4e9d6;
}
page {
  background: #eee9df;
  color: var(--ink);
  font-family: 'Microsoft YaHei', 'PingFang SC', Arial, sans-serif;
  font-size: 14px;
  -webkit-font-smoothing: antialiased;
}
.h1,
.h2,
.h3,
.h4,
.strong,
.strong {
  font-family: inherit;
}
.h2 {
  font-weight: 800;
  letter-spacing: -0.5px;
}
.copy {
  color: inherit;
}
.muted {
  color: #8d7969;
}
.caption {
  color: #998571;
  font-size: 12px;
}
.phone {
  background: var(--paper);
  box-shadow:
    0 20px 55px #422d2610,
    0 0 0 7px #fffefa,
    0 0 0 8px #d7cebf;
  border-radius: 30px;
}
