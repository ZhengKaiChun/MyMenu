  font-size: 10px;
  letter-spacing: 1px;
}
.btn {
  background: #4b3026;
  border-color: #4b3026;
  color: #fffbf2;
  border-radius: 15px;
  min-height: 49px;
  font-size: 14px;
  font-weight: 700;
  gap: 8px;
  padding: 12px 16px;
