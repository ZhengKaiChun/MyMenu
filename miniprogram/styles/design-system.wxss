page {
  height: 100%;
  background: #fffcf6;
  color: #422d26;
  font-family:
    system-ui,
    -apple-system,
    'PingFang SC',
    sans-serif;
  font-size: 14px;
  line-height: 1.6;
}
view,
text,
button,
input,
textarea,
image {
  box-sizing: border-box;
}
button {
  padding: 0;
  margin: 0;
  background: transparent;
  border: 0;
  line-height: 1.6;
  font-size: 14px;
  color: inherit;
  font-weight: 400;
}
button::after {
  border: none;
}
button[disabled] {
  opacity: 0.45;
}
input {
  width: 100%;
}
textarea {
  width: 100%;
  box-sizing: border-box;
}
image {
  display: block;
}
.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
}
.start {
  justify-content: flex-start;
}
.grow {
  flex: 1;
  min-width: 0;
}
.two {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12px;
}
.h2 {
  font-size: 27px;
  font-weight: 800;
  line-height: 1.5;
  margin: 0 0 10px;
}
.h3 {
  font-size: 17px;
  font-weight: 700;
}
.h4 {
  font-size: 15px;
  font-weight: 700;
}
.form-label {
  display: block;
}
.input {
  display: block;
  width: 100%;
  height: 49px;
}
.btn {
  width: 100%;
}
.food {
  display: block;
  flex-shrink: 0;
  object-fit: cover;
}
.tag {
  display: inline-block;
}
.checkline {
  display: flex;
  align-items: center;
  gap: 9px;
}
.card {
  display: block;
}
.caption {
  display: block;
}
.section-title {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.page-content {
  padding: 18px 22px 25px;
}
.page-content.flush {
  padding: 0;
}
.list-row {
  display: flex;
  width: 100%;
  align-items: center;
  justify-content: space-between;
  text-align: left;
}
.error-tip {
  color: #b74f37;
  font-size: 12px;
  padding: 11px;
  border: 1px solid #e9c9b3;
  border-radius: 12px;
  margin: 10px 0;
}
.privacy-foot {
  font-size: 11px;
  color: #ad9879;
  line-height: 1.9;
}
.scroll {
  height: 100%;
  min-height: 0;
}
.modal-mask {
  position: fixed;
  inset: 0;
  z-index: 100;
  background: rgba(54, 37, 29, 0.38);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 22px;
}
.sheet-mask {
  align-items: flex-end;
  padding: 0;
}
.native-dialog {
  max-height: 85vh;
  overflow: auto;
}
.pill-row {
  display: flex;
  gap: 8px;
  flex-wrap: wrap;
}
.empty {
  padding: 30px 10px;
  text-align: center;
}
.avatar {
  overflow: hidden;
}
.step-photo {
  height: 170px;
  width: 100%;
  border-radius: 14px;
}
.field-gap {
  margin-top: 13px;
}

page {
  --paper: #fbf8f1;
  --white: #fffefb;
  --ink: #46362a;
  --muted: #8d7c6b;
  --line: #e9e1d4;
  --orange: #936849;
  --pink: #f5dfd3;
  --sage: #6f7c61;
  --green: #edf0e5;
  --sand: #f2e9d9;
  --shadow: 0 5px 20px #58402c04;
}
page {
  background: #ede9e0;
  color: var(--ink);
  font-family: 'Microsoft YaHei UI', 'Microsoft YaHei', 'PingFang SC', Arial, sans-serif;
  font-size: 14px;
  line-height: 1.6;
}
.h1,
.h2,
.h3,
.h4 {
  font-family: inherit;
  letter-spacing: 0;
}
.h2 {
  font-size: 25px;
  line-height: 1.4;
  font-weight: 700;
  margin: 0 0 8px;
}
.h3 {
  font-size: 17px;
  line-height: 1.5;
}
.h4 {
  font-size: 15px;
  line-height: 1.5;
}
.muted {
  color: var(--muted);
  font-size: 12px;
  line-height: 1.8;
}
.caption {
  font-size: 11px;
  color: #958574;
  line-height: 1.6;
}
.overline,
.chapter {
  display: none;
}
.sketch,
.ico {
  width: 25px;
  height: 25px;
  display: inline-block;
  vertical-align: middle;
  flex-shrink: 0;
  color: inherit;
}
.pig-art {
  width: 100%;
  height: 100%;
  display: block;
  overflow: hidden;
}
.action-art.object-art {
  width: 46px;
  height: 46px;
  display: block;
  color: #8b6848;
}
.avatar {
  width: 43px;
  height: 43px;
  border: 0;
  background: #f2e9d9;
  border-radius: 50%;
  padding: 2px;
  flex-shrink: 0;
}
.avatar.big {
  width: 76px;
  height: 76px;
  padding: 2px;
  background: #f0e5d2;
}
.content {
  padding: 17px 20px 24px;
  scrollbar-width: none;
}
.content.flush {
  padding: 0 0 18px;
}
.phone {
  background: var(--paper);
  border-radius: 32px;
  box-shadow:
    0 22px 55px #56402c18,
    0 0 0 7px #fffdf7,
    0 0 0 8px #dfd5c4;
}
.phone:after {
  content: '';
  position: absolute;
  bottom: 6px;
  left: calc(50% - 44px);
  height: 3px;
  width: 88px;
  border-radius: 5px;
  background: #baa992;
  pointer-events: none;
  z-index: 20;
}
.statusbar {
  height: 47px;
  color: #514333;
  padding: 0 25px;
}
.wxnav {
  height: 47px;
  padding: 0 20px;
}
.wxnav .strong {
  font-size: 15px;
  font-weight: 650;
}
.wxnav .back {
  font-size: 26px;
}
.capsule {
  border-color: #ddd3c3;
  color: #816d55;
  background: #ffffff38;
}
.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  min-height: 48px;
  padding: 11px 16px;
  border: 1px solid #71513a;
  background: #71513a;
  color: #fffaf0;
  border-radius: 13px;
  font-size: 14px;
  font-weight: 600;
  box-shadow: none;
  line-height: 1.5;
}
.btn-doodle {
  width: 21px;
  height: 21px;
  color: inherit;
}
.btn.secondary {
  border-color: #e4d7c1;
  background: #f2e8d6;
  color: #856445;
}
.btn.accent {
  background: #a47353;
  border-color: #a47353;
}
.btn.ghost {
  background: transparent;
  border: 1px solid #d9c8ad;
  color: #8e6a47;
}
.btn.green {
  background: #7d886c;
  border-color: #7d886c;
  color: white;
}
.btn.small {
  min-height: 42px;
  padding: 9px 13px;
  font-size: 12px;
  gap: 6px;
}
.btn.small .btn-doodle {
  width: 19px;
  height: 19px;
}
.text-btn {
  font-size: 12px;
  color: #93724e;
  padding: 5px 7px;
  min-height: 36px;
}
.tag {
  font-size: 10px;
  padding: 3px 7px;
  border-radius: 5px;
  line-height: 1.5;
  background: #f3eadb;
  color: #967b59;
}
.tag.good {
  background: #eaf0e3;
  color: #728264;
}
.tag.wait {
  background: #f7ebcf;
  color: #a4854c;
}
.tag.pink {
  background: #f5e0d4;
  color: #b0836b;
}
.card {
  border: 1px solid var(--line);
  border-radius: 16px;
  padding: 16px;
  background: var(--white);
  box-shadow: none;
  margin: 13px 0;
}
.card.pink {
  background: #f7ece2;
  border-color: #eed9c4;
}
.card.green {
  background: #f0f4e9;
  border-color: #e0e7d4;
}
.card.tint {
  background: #f5eddf;
  border-color: #e9dcc8;
}
.section-title {
  margin: 25px 0 12px;
  min-height: 25px;
}
.section-title .h3 {
  font-size: 15px;
  font-weight: 650;
  margin: 0;
}
.section-title button {
  font-size: 11px;
}
.page-intro {
  margin: 0 0 22px;
  padding: 0;
}
.page-intro .h2 {
  font-size: 24px;
  line-height: 1.5;
  margin: 0 0 7px;
}
.page-intro .copy {
  font-size: 12px;
  color: #9a8976;
  line-height: 1.8;
  margin: 0;
  max-width: 100%;
}
.page-intro:after {
  display: none;
}
.form-label {
  font-size: 13px;
  font-weight: 600;
  color: #78624d;
  margin: 19px 0 7px;
}
.input,
textarea,
.select {
  background: #fffef9;
  border: 1px solid #e2d7c5;
  border-radius: 11px;
  padding: 12px 13px;
  font-size: 13px;
  min-height: 46px;
  outline-color: #b69872;
  box-shadow: none;
}
.input::placeholder,
textarea::placeholder {
  color: #b4a58f;
}
.input:focus,
textarea:focus,
select:focus {
  border-color: #b89a75;
  box-shadow: 0 0 0 3px #c6b48e10;
}
textarea {
  line-height: 1.8;
  min-height: 84px;
}
.input[type='number'] {
  padding-right: 7px;
}
.two {
  gap: 12px;
}
.checkline {
  font-size: 12px;
  line-height: 1.8;
  gap: 9px;
  color: #8b7863;
}
.checkline input[type='checkbox'],
input[type='checkbox'] {
  accent-color: #8b795d;
  width: 18px;
  height: 18px;
}
.pill {
  min-height: 36px;
  padding: 7px 12px;
  font-size: 12px;
  border-radius: 10px;
  border: 1px solid #e4d8c5;
  background: #fffdf6;
  color: #9b825f;
}
.pill.active {
  background: #806145;
  border-color: #806145;
  color: #fff6e5;
}
.chips {
  gap: 8px;
  margin: 15px 0;
}
.search {
  height: 43px;
  padding: 0 13px;
  border: 1px solid #eee6d7;
  background: #f3eee3;
  border-radius: 12px;
  margin: 13px 0;
}
.search .ico {
  width: 20px;
  height: 20px;
  color: #ad9a7f;
}
.search input {
  font-size: 12px;
}
.search input::placeholder {
  color: #b3a188;
}
.inline-hint {
  font-size: 11px;
  line-height: 1.8;
  color: #a18e74;
  margin: 14px 0;
}
.notice,
.folded-note {
  background: none;
  border: 0;
  border-radius: 0;
  padding: 0;
  font-size: 11px;
  color: #a18e74;
}
.quote {
  border-left: 2px solid #dcc9a9;
  border-radius: 0 10px 10px 0;
  background: #f7f0e1;
  padding: 11px 13px;
  font-size: 12px;
  color: #9c8262;
}
.divider {
  border-top-color: #e5d8bf;
  margin: 19px 0;
}
.food {
  width: 86px;
  height: 86px;
  border: 0;
  border-radius: 13px;
}
.food.large {
  width: 100%;
  height: 251px;
  border-radius: 0 0 20px 20px;
}
.food.mid {
  width: 100%;
  height: 172px;
  border-radius: 15px;
}
.food.step-photo {
  width: 100%;
  height: 164px;
  border-radius: 13px;
}
.dish {
  padding: 14px 0;
  gap: 13px;
  border-bottom: 1px solid #eee5d5;
  align-items: center;
}
.dish .h4 {
  font-size: 15px;
  margin-bottom: 4px;
}
.dish .small-text {
  font-size: 11px;
  line-height: 1.65;
  color: #a08d74;
}
.dish .caption {
  font-size: 10px;
}
.dish .add {
  width: 36px;
  min-height: 36px;
  background: #ece1ce;
  border: 1px solid #d9c2a0;
  border-radius: 50%;
  color: #9a7750;
  font-size: 20px;
}
.link-label {
  display: flex;
  align-items: center;
  gap: 12px;
  min-width: 0;
  flex: 1;
  color: #6d5945 !important;
  font-size: 13px !important;
}
.link-label > .sketch {
  width: 25px;
  height: 25px;
  color: #ad8860;
}
.link-label > text {
  font-size: 13px !important;
  color: #6d5945 !important;
}
.link-extra {
  font-size: 11px !important;
  white-space: nowrap;
  color: #b19b7d !important;
}
.link-extra .strong {
  font-size: 18px;
  font-weight: 400;
  margin-left: 4px;
  color: #b4a187;
}
.list-row {
  min-height: 54px;
  padding: 12px 0;
  border-color: #eee5d5;
  font-size: 13px;
}
.list-row > text:last-child {
  font-size: 12px;
  color: #ab977a;
}
.list-row .link-label {
  line-height: 1.5;
}
.dock {
  padding: 13px 20px 26px;
  background: #fffdf7;
  border-top: 1px solid #e9dfcb;
}
.dock > .row {
  gap: 12px;
}
.tabbar {
  height: 78px;
  flex-shrink: 0;
  background: #fffdf8;
  border-top: 1px solid #e8dfcf;
  padding: 9px 15px 19px;
  gap: 5px;
}
.tabbar button {
  color: #b0a08b;
  gap: 3px;
  font-size: 10px;
  line-height: 1.4;
  min-height: 48px;
}
.tabbar .ico {
  width: 25px;
  height: 25px;
}
.tabbar button.on {
  color: #806040;
  font-weight: 650;
}
.tabbar button.on:after {
  content: '';
  width: 12px;
  height: 2px;
  background: #b7956b;
  border-radius: 2px;
  margin-top: 1px;
}
.hero {
  background: transparent;
  border: 0;
  box-shadow: none;
  border-radius: 17px;
  overflow: hidden;
  margin: 12px 0 19px;
}
.hero image {
  width: 100%;
  object-fit: contain;
  mix-blend-mode: multiply;
  display: block;
  border-radius: 17px;
}
.hero.home image {
  height: 193px;
  object-fit: contain;
}
.hero-copy {
  display: none;
}
.hero.login {
  margin: 0;
}
.empty {
  padding: 20px 6px;
  text-align: center;
}
.empty .hero {
  width: 253px;
  max-width: 100%;
  margin: 0 auto 24px;
}
.empty .hero image {
  height: 174px;
  object-fit: contain;
}
.empty .h2 {
  font-size: 24px;
}
.empty .h3 {
  font-size: 20px;
}
.empty .copy {
  font-size: 12px;
  color: #9e8a70;
  line-height: 1.9;
  margin: 12px 0 25px;
}
.empty .btn {
  margin: 11px 0;
}
.upload {
  min-height: 144px;
  border: 1px dashed #d6c2a2;
  background: #f4eddf;
  border-radius: 13px;
  color: #af9877;
  font-size: 12px;
}
.upload image {
  width: 100%;
  height: 144px;
  object-fit: cover;
}
.steps {
  margin-top: 15px;
}
.step {
  margin-top: 22px;
}
.step-num {
  font-size: 11px;
  letter-spacing: 0.8px;
  color: #a78b5e;
  margin-bottom: 11px;
}
.step .copy {
  font-size: 13px;
  line-height: 1.9;
  color: #816b51;
}
.rolebox {
  background: #fffdf7;
  border: 1px solid #e5d8c2;
  border-radius: 14px;
  padding: 15px;
  gap: 12px;
  margin: 11px 0;
}
.rolebox.selected {
  background: #f3ead8;
  border-color: #bd9d74;
  box-shadow: 0 0 0 1px #bd9d7410;
}
.rolebox .strong {
  font-size: 14px;
}
.rolebox .copy {
  font-size: 11px;
  color: #a08a6e;
  margin: 4px 0 0;
}
.role-action {
  width: 48px !important;
  height: 48px !important;
  color: #a57f56;
}
.identity-pig {
  width: 69px;
  height: 69px;
  flex-shrink: 0;
}
.page-identity .page-intro {
  margin-bottom: 16px;
}
.timeline {
  border-color: #dfcdb0;
  padding-left: 20px;
  margin: 24px 0 10px 6px;
}
.timeline > view {
  margin: 21px 0;
}
.timeline > view:before {
  background: #a9b08b;
  border-color: var(--paper);
  left: -28px;
}
.timeline .strong {
  font-size: 13px;
}
.timeline .copy {
  font-size: 11px;
}
.progress {
  height: 5px;
  background: #eadfc9;
  border-radius: 4px;
  margin: 18px 0;
}
.progress > .decoration {
  background: #a7b18a;
}
.calendar {
  gap: 5px;
}
.calendar button {
  height: 39px;
  min-height: 39px;
  color: #99846a;
}
.calendar button.on {
  background: #866749;
  color: #fff5e5;
  border-radius: 50%;
}
.calendar button.dot:after {
  background: #c09a70;
}
.calendar .weekday {
  font-size: 10px;
  color: #b39f81;
}
.datebar {
  gap: 8px;
  margin: 16px 0 23px;
}
.date {
  border: 1px solid #e8dcc5;
  background: #fffdf6;
  border-radius: 12px;
  min-width: 43px;
  min-height: 66px;
  color: #a9987b;
  padding: 7px 3px;
  font-size: 10px;
}
.date .strong {
  font-size: 19px;
  color: #8e7353;
}
.date.on {
  background: #87684a;
  border-color: #87684a;
  color: #e5d8bd;
}
.date.on .strong {
  color: #fff5e4;
}
.badge-count {
  background: #bb8f71;
  font-size: 10px;
}
.ingredient {
  padding: 15px 0;
  min-height: 73px;
  border-color: #eadfc9;
  gap: 12px;
}
.ingredient .ing-name {
  font-size: 14px;
}
.ingredient .caption {
  font-size: 11px;
  color: #b29c7d;
  margin-top: 4px;
}
.ingredient .amount {
  font-size: 12px;
  color: #ac9270;
  white-space: nowrap;
}
.ingredient.checked .ing-name {
  color: #a6ad90;
}
.ingredient .tag {
  font-size: 9px;
}
.sheet {
  background: #fffdf6;
  border-radius: 25px 25px 0 0;
  padding: 12px 20px 28px;
  box-shadow: 0 -15px 40px #4235200b;
  max-height: 88%;
}
.handle {
  width: 31px;
  height: 3px;
  background: #d9cbb4;
  margin-bottom: 17px;
}
.sheet-title {
  margin-bottom: 17px;
  align-items: center;
}
.sheet-title .h3 {
  font-size: 20px;
  margin: 0;
  line-height: 1.5;
}
.sheet .close {
  font-size: 23px;
  color: #ac977a;
  min-width: 40px;
  min-height: 40px;
}
.sheet > .muted {
  font-size: 12px;
  line-height: 1.8;
}
.sheet .form-label {
  margin-top: 18px;
}
.sheet .card {
  border: 0;
  background: #f4ebda;
  border-radius: 14px;
  padding: 15px;
}
.sheet .inline-hint {
  font-size: 11px;
  line-height: 1.85;
}
.sheet .btn + .btn {
  margin-top: 10px;
}
.modal {
  background: #fffdf6;
  border: 1px solid #e8dbc3;
  border-radius: 21px;
  padding: 27px 22px;
  width: 100%;
  box-shadow: 0 18px 50px #4e38231c;
}
.modal .h3 {
  font-size: 21px;
  line-height: 1.5;
  margin: 0;
}
.modal .copy {
  font-size: 12px;
  line-height: 1.9;
  color: #9d876a;
  margin: 15px 0 25px;
}
.modal .btn {
  font-size: 12px;
}
.modal .row {
  gap: 11px;
}
#overlay,
.gallery-grid .phone .overlay-static {
  background: #3c2d204d;
}
#toast {
  background: #5b4836ed;
  font-size: 12px;
  border-radius: 12px;
  padding: 12px 17px;
}

.home-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 0 0 21px;
  gap: 15px;
}
.home-top .copy {
  font-size: 12px;
  color: #a38c6c;
  margin: 0 0 5px;
}
.home-top .h2 {
  font-size: 28px;
  margin: 0;
  font-weight: 700;
  letter-spacing: 0.5px;
}
.home-top > button {
  padding: 0;
  min-height: 46px;
}
.home-top .avatar {
  width: 46px;
  height: 46px;
  background: #eee3d0;
}
.house-card {
  position: relative;
  padding: 18px 20px 17px;
  border: 1px solid #e3d4ba;
  border-radius: 18px;
  background: #f0e5cf;
