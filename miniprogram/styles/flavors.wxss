.flavor-mask {
  display: flex;
  align-items: flex-end;
  justify-content: center;
}
.flavor-sheet {
  width: 100%;
  max-height: 78vh;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  padding: 19px 20px calc(20px + env(safe-area-inset-bottom));
  border-radius: 25px 25px 0 0;
  background: #fffaf0;
  box-shadow: 0 -7px 26px #422e2225;
}
.flavor-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  padding-bottom: 14px;
  border-bottom: 1px dashed #dcc9ad;
}
.flavor-head > view {
  display: flex;
  flex-direction: column;
  gap: 4px;
}
.flavor-head text:first-child {
  font-size: 19px;
  font-weight: 700;
  color: #5a392e;
}
.flavor-head text:last-child {
  font-size: 12px;
  color: #a48164;
}
.flavor-head button {
  margin: 0;
  padding: 0 5px;
  color: #987b62;
  font-size: 22px;
}
.flavor-scroll {
  flex: 1;
  min-height: 0;
  max-height: 58vh;
}
.flavor-group {
  padding: 15px 0;
  border-bottom: 1px solid #efe2cf;
}
.flavor-group-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 11px;
}
.flavor-group-head text:first-child {
  font-size: 15px;
  font-weight: 700;
  color: #604535;
}
.flavor-group-head text:last-child {
  font-size: 11px;
  color: #9d846b;
}
.flavor-choices {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
}
.flavor-choices button {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
  min-width: calc(50% - 4px);
  max-width: 100%;
  box-sizing: border-box;
  padding: 10px 12px;
  margin: 0;
  border: 1px solid #e3d4bf;
  border-radius: 12px;
  background: #f8f0e4;
  color: #795c47;
  font-size: 12px;
  text-align: left;
  line-height: 1.4;
}
.flavor-choices button.selected {
  background: #efe1c3;
  border-color: #bd966d;
  color: #543927;
}
.flavor-confirm {
  margin: 15px 0 0;
  flex: none;
}
.order-flavor-summary {
  display: block;
  margin-top: 3px;
  color: #a57557;
  font-size: 11px;
  line-height: 1.5;
}
