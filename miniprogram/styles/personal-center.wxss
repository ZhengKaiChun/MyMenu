.achievement-entry {
  width: 100%;
  padding: 17px !important;
  border: 1px solid #d5ba83;
  border-radius: 20px;
  background: #f4e7c9;
  box-shadow: 0 4px 0 #e8d7b5;
  text-align: left;
  margin: 19px 0 25px !important;
}
.achievement-entry-title {
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 13px;
  color: #80603a;
}
.achievement-entry-title > text:last-child {
  font-size: 10px;
  color: #ad885a;
}
.achievement-numbers {
  display: flex;
  margin-top: 18px;
}
.achievement-numbers > view {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 3px;
}
.achievement-numbers > view + view {
  border-left: 1px dashed #d8c197;
}
.achievement-numbers > view > text:first-child {
  font-size: 31px;
  font-weight: 750;
  color: #805333;
  line-height: 1.25;
}
.achievement-numbers > view > text:last-child {
  font-size: 11px;
  color: #a48661;
}
.security-heading {
  display: flex;
  align-items: center;
  gap: 14px;
  padding: 15px 0 24px;
}
.security-heading .h2 {
  font-size: 22px;
  margin: 0;
}
.security-heading text {
  font-size: 11px;
  color: #a78b6a;
}
.security-form {
  padding: 4px 15px 18px;
  border: 1px solid #e1cfaf;
  border-radius: 20px;
  background: #fff9ed;
}
.security-form input.input {
  height: 47px;
  line-height: 47px;
  padding: 0 12px;
}
.security-help {
  display: block;
  color: #aa8e6a;
  font-size: 11px;
  margin: 17px 4px;
}
.achievement-pass {
  padding: 23px 18px;
  background: #f3e7cb;
  border: 1px solid #d6bd91;
  border-radius: 23px;
  box-shadow: 0 4px 0 #e9d8b9;
}
.achievement-pass > g-icon {
  display: block;
  width: 32px;
  margin: 0 auto 10px;
}
.achievement-kicker {
  display: block;
  text-align: center;
  font-size: 14px;
  font-weight: 600;
  color: #8e6c42;
}
.page-achievements .section-title {
  margin: 29px 0 13px;
}
.family-achievement {
  padding: 15px;
  margin-bottom: 12px;
  border: 1px solid #e3d2b6;
  border-radius: 17px;
  background: #fffaf0;
}
.family-achievement .row > .grow {
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 13px;
}
.record-cooking-btn {
  padding: 5px 8px !important;
  font-size: 10px;
  border: 1px solid #bdc39d;
  background: #eeefdd;
  border-radius: 9px;
  color: #778157;
  flex: none;
}
.family-achievement-counts {
  display: flex;
  gap: 30px;
  margin: 15px 0 0 35px;
  font-size: 11px;
  color: #aa8e6a;
}
.family-achievement-counts .strong {
  font-size: 17px;
  color: #855f3b;
  padding: 0 3px;
}
.achievement-rules {
  padding: 13px;
  color: #a58c6d;
  font-size: 10px;
  line-height: 1.8;
  border-top: 1px dashed #ddcaac;
}
.cooking-fixed {
  display: flex;
  flex-direction: column;
  height: 100%;
  min-height: 0;
}
.cooking-head {
  padding: 18px 22px 0;
  flex: none;
}
.cooking-head .h2 {
  font-size: 25px;
  margin: 0 0 5px;
}
.cooking-schedule {
  margin-top: 15px;
  gap: 8px;
}
.cooking-schedule .meal-switch button {
  padding: 0 8px !important;
  font-size: 11px;
}
.cooking-list {
  height: 0;
  flex: 1;
  min-height: 0;
  padding: 8px 22px 16px;
  box-sizing: border-box;
}
.cooking-dish {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 10px;
  border: 1px solid #e4d4b8;
  background: #fffaf1;
  border-radius: 15px;
  margin-bottom: 10px;
}
.cooking-dish > image {
  width: 61px;
  height: 61px;
  border-radius: 12px;
  flex: none;
}
.cooking-dish > text {
  font-size: 13px;
}
.cooking-dish checkbox {
  transform: scale(0.85);
  transform-origin: right center;
}
