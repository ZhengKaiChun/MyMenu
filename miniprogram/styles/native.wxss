/* Keep the import letter full width and inside the native viewport. */
.sheet-mask {
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
}
.sheet.pantry-import {
  width: 100%;
  box-sizing: border-box;
  max-height: 85vh;
  display: flex;
  flex-direction: column;
  flex: none;
  padding: 22px 22px calc(20px + env(safe-area-inset-bottom));
  overflow: hidden;
}
.pantry-import .sheet-title {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  flex: none;
  margin-bottom: 12px;
}
.pantry-import .close {
  flex: none;
  align-self: flex-start;
}
.pantry-import > .caption,
.pantry-import > .btn {
  flex: none;
}
.pantry-import .import-scroll {
  min-height: 0;
  max-height: 38vh;
  flex-shrink: 1;
}
