.today-dish-actions {
  flex: none;
  width: 60px;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 2px;
}
.today-complete-slot {
  width: 60px;
  height: 30px;
  flex: none;
}
.today-swap-slot {
  width: 60px;
  height: 26px;
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
}
.today-dish-actions .cook-check,
.today-dish-actions .cook-completed {
  width: 60px;
  height: 30px;
  min-height: 30px;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  gap: 4px;
  padding: 0 !important;
  margin: 0 !important;
  border: 0;
  border-radius: 7px;
  background: transparent;
  color: #ad9675;
  font-size: 10px;
  line-height: 16px;
  white-space: nowrap;
  box-sizing: border-box;
}
.cook-check-box {
  width: 15px;
  height: 15px;
  flex: none;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1px solid #c9b58e;
  border-radius: 5px;
  background: #fffcf5;
  font-size: 11px;
  line-height: 1;
  color: transparent;
}
.today-dish-actions .cook-check.checked,
.today-dish-actions .cook-completed {
  color: #8b9569;
}
.cook-check.checked .cook-check-box,
.cook-completed .cook-check-box {
  background: #98a276;
  border-color: #98a276;
  color: #fffdf4;
}
.today-dish-actions .swap-button {
  height: 26px;
  min-height: 26px;
  padding: 3px 8px !important;
  margin: 0 !important;
  font-size: 10px;
  line-height: 20px;
  text-align: center;
}
.diary-cooker {
  display: flex;
  align-items: center;
  gap: 5px;
  color: #8c946c;
  font-size: 10px;
  margin-top: 4px;
}
.diary-orderers .diary-credit-label {
  color: #b39a76;
  margin-right: 4px;
}
.diary-dish > image {
  height: 55%;
}
.cooking-letter {
  padding: 23px 20px;
  border: 1px solid #d8bd94;
  border-radius: 20px 20px 9px 9px;
  background: repeating-linear-gradient(#fff9ec, #fff9ec 31px, #eee2ca 32px);
  box-shadow: 0 5px 0 #e7d6b6;
  text-align: center;
}
.letter-eyebrow {
  font-size: 11px;
  color: #ad8a5d;
  margin-bottom: 12px;
}
.cooking-letter .h2 {
  font-size: 23px;
  margin-bottom: 7px;
}
.cooking-letter > image {
  width: 100%;
  height: 190px;
  border-radius: 17px;
  margin: 18px 0 12px;
}
.cooking-letter .btn {
  margin-top: 17px;
}
.claim-help {
  display: block;
  color: #a38965;
  font-size: 11px;
  line-height: 1.8;
  margin-top: 13px;
}
.claim-resolved {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  background: #e9ecd6;
  color: #808b5b;
  border-radius: 12px;
  padding: 12px;
  margin-top: 15px;
  font-size: 12px;
}
.inbox-tabs button {
  min-width: 0;
  flex: 1;
  padding-left: 4px !important;
  padding-right: 4px !important;
  font-size: 11px;
}
