<wxs module="util" src="../../lib/format.wxs"/>
<g-shell id="page-shell" title="小家的食材库" back="{{false}}"><view class="pantry-fixed-page">
<view class="pantry-fixed-head"><view class="pantry-title-row"><view class="h2">小家食材库</view><g-icon name="basket" size="30"/></view><view class="row pantry-total"><text>共 {{totalCount}} 种食材</text><button hover-class="none" class="text-btn" bindtap="showImport">从个人食材导入 ↙</button></view><view class="search row"><g-icon name="search" size="20"/><input placeholder="找找冰箱里的食材" value="{{query}}" bindinput="search"/></view><scroll-view scroll-x class="category-tabs"><view><button hover-class="none" wx:for="{{categoryTabs}}" wx:key="id" bindtap="categoryTab" data-id="{{item.id}}" class="{{activeCategory===item.id?'active':''}}">{{item.name}}<text>{{item.count}}</text></button></view></scroll-view><view wx:if="{{activeCategory==='肉类'}}" class="meat-fixed-tabs"><button hover-class="none" wx:for="{{meatTypes}}" wx:key="*this" bindtap="meatTab" data-type="{{item}}" class="{{meatType===item?'active':''}}">{{item}}</button></view></view>
<view wx:if="{{error}}" class="error-tip" bindtap="retry">{{error}}</view><scroll-view scroll-y class="pantry-list-scroll"><view class="pantry-list-content"><view wx:for="{{items}}" wx:key="id" class="card row pantry-item"><view class="avatar"><g-icon name="{{item.icon}}" size="29"/></view><view class="grow"><view class="h4 strong">{{item.name}}</view><text class="caption copy small-text">{{item.quantity}} {{item.unit}} · {{item.category}}{{item.meatType?' / '+item.meatType:''}}</text></view><button hover-class="none" class="text-btn" data-id="{{item.id}}" bindtap="edit">编辑</button></view><view wx:if="{{!items.length}}" class="empty"><g-icon name="basket" size="42"/><view>这格冰箱还空着</view><text class="caption">换个分类，或添加几样食材吧</text></view><button hover-class="none" wx:if="{{canMatch}}" class="btn secondary" bindtap="go" data-page="match"><g-icon name="basket" size="21"/>看看这些食材能做什么</button></view></scroll-view></view><view slot="dock" class="dock dock-with-tabs"><button hover-class="none" class="btn" bindtap="add"><g-icon name="plus" size="21" tone="light"/>添加食材</button></view><g-tabbar slot="tabs" active="pantry"/></g-shell>
<view wx:if="{{showImport}}" class="modal-mask import-mask" bindtap="closeImport"><view class="import-dialog" catchtap="noop">
<view class="import-letter-head"><view class="fridge-stamp"><g-icon name="basket" size="30"/></view><view class="grow"><text class="import-eyebrow">MY LITTLE FRIDGE</text><view class="h3">带几样食材回家</view></view><button hover-class="none" class="import-close" bindtap="closeImport">×</button></view>
<text class="import-help">从个人冰箱挑选，小家已有的数量会保留</text>
<view class="search row import-search"><g-icon name="search" size="18"/><input placeholder="找一种食材" value="{{importQuery}}" bindinput="importSearch"/></view>
<scroll-view scroll-x class="import-tabs"><view><button hover-class="none" wx:for="{{importTabs}}" wx:key="id" class="{{importCategory===item.id?'active':''}}" bindtap="importCategory" data-id="{{item.id}}">{{item.name}} {{item.count}}</button></view></scroll-view>
<view class="import-selection-bar"><text>个人冰箱 · {{personalItems.length}} 种</text><button hover-class="none" bindtap="allImport">{{importAll?'取消本栏':'全选本栏'}}</button></view>
<scroll-view scroll-y class="import-grid-scroll" style="height:{{importHeight}}px"><checkbox-group bindchange="selectImport"><view wx:for="{{importGroups}}" wx:for-item="group" wx:key="name" class="import-section"><view class="import-group-name">{{group.name}}</view><view class="import-grid"><label wx:for="{{group.items}}" wx:key="id" class="import-tile {{util.contains(importIds,item.id)?'selected':''}}"><checkbox value="{{item.id}}" checked="{{util.contains(importIds,item.id)}}" color="#a66d48"/><view><text class="import-name">{{item.name}}</text><text class="import-unit">{{item.quantity}} {{item.unit}}</text></view></label></view></view></checkbox-group><view wx:if="{{!importVisible.length}}" class="empty">{{personalItems.length?'没有找到，换个名字试试':'个人冰箱还是空的'}}</view></scroll-view>
<view class="import-footer"><view><text class="strong">已挑选 {{importIds.length}} 种</text><text>跨分类选择会一起保留</text></view><button hover-class="none" class="btn" bindtap="importItems" disabled="{{!importIds.length}}">放进小家冰箱</button></view>
</view></view>
