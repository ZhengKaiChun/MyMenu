<wxs module="util" src="../../lib/format.wxs" />
<g-shell title="小家的食材库" back="{{false}}">
  <scroll-view scroll-y class="scroll">
    <view class="page-content page-pantry">
      <view wx:if="{{error}}" class="error-tip" bindtap="retry">{{error}} · 点击重试</view>
      <view class="page-intro">
        <view class="h2">小家食材库</view>
      </view>
      <view class="row">
        <text class="caption copy small-text">共 {{items.length}} 种食材</text>
        <button hover-class="none" wx:if="{{isCook}}" class="text-btn" bindtap="showImport">从个人食材导入 ↙</button>
      </view>
      <view class="search row">
        <g-icon name="search" size="20" />
        <input placeholder="找找冰箱里的食材" value="{{query}}" bindinput="search" />
      </view>
<view wx:for="{{groups}}" wx:for-item="group" wx:key="name" class="pantry-group"><view class="group-heading"><text>{{group.name}}</text><text>{{group.items.length}}种</text></view>      <view wx:for="{{group.items}}" wx:key="id" class="card row pantry-item">
        <view class="avatar"><g-icon name="{{item.icon}}" size="29" /></view>
        <view class="grow">
          <view class="h4 strong">{{item.name}}</view>
          <text class="caption copy small-text">{{item.quantity}} {{item.unit}} · {{item.category}}</text>
        </view>
        <button hover-class="none" wx:if="{{isCook}}" class="text-btn" data-id="{{item.id}}" bindtap="edit">
          编辑
        </button>
      </view>
</view>      <button hover-class="none" wx:if="{{canMatch}}" class="btn secondary" bindtap="go" data-page="match">
        <g-icon name="basket" size="21" tone="" />
        看看这些食材能做什么
      </button>
    </view>
  </scroll-view>
  <view slot="dock" class="dock dock-with-tabs">
    <button hover-class="none" wx:if="{{isCook}}" class="btn" bindtap="add">
      <g-icon name="plus" size="21" tone="light" />
      添加食材
    </button>
  </view>
  <g-tabbar slot="tabs" active="pantry" />
</g-shell>
<view wx:if="{{showImport}}" class="modal-mask sheet-mask" bindtap="closeImport"><view class="sheet pantry-import" catchtap="noop"><view class="sheet-title"><view><text class="import-eyebrow">从我的冰箱，带到小家</text><view class="h3">带上现有食材</view></view><button hover-class="none" class="close" bindtap="closeImport">×</button></view><text class="caption">勾选想带来的食材，小家已有数量会保留</text><scroll-view scroll-y class="import-scroll" style="height:{{personalItems.length > 4 ? 320 : personalItems.length * 66}}px"><checkbox-group bindchange="selectImport"><label wx:for="{{personalItems}}" wx:key="id" class="import-row"><checkbox value="{{item.id}}" color="#b74f37"/><view class="grow"><view class="h4">{{item.name}}</view><text class="caption">{{item.category}}</text></view><text class="import-amount">{{item.quantity}} {{item.unit}}</text></label></checkbox-group><view wx:if="{{!personalItems.length}}" class="empty">个人冰箱还是空的，先添加几样食材吧。</view></scroll-view><button hover-class="none" class="btn" bindtap="importItems" disabled="{{!importIds.length}}">带入小家 · 已选{{importIds.length}}种</button></view></view>