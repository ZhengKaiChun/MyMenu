<wxs module="util" src="../../lib/format.wxs" />
<g-shell id="page-shell" title="一份想吃的心愿" back="{{true}}">
  <scroll-view class="scroll" scroll-y>
    <view class="page-content page-requestDetail">
      <view wx:if="{{error}}" class="error-tip" bindtap="retry">{{error}} · 点击重试</view>
      <view wx:if="{{order}}">
        <view class="row">
          <view class="h2">{{util.date(order.meal_date)}} · {{order.slot}}</view>
          <text class="tag wait">{{label}}</text>
        </view>
        <view class="row start" style="margin: 20px 0">
          <g-pig index="7" size="43" />
          <view>
            <view class="h4 strong">{{order.nickname}}</view>
            <text class="caption copy small-text">{{order.identity}} · 发来一条吃饭申请</text>
          </view>
        </view>
        <view wx:for="{{order.items}}" wx:key="id" class="dish">
          <image class="food" src="{{item.cover}}" mode="aspectFill" />
          <view class="grow">
            <view class="h4 strong">{{item.name}}</view>
            <text class="caption copy small-text">{{item.quantity}}份</text>
          </view>
        </view>
        <view class="section-title"><view class="h3 strong">小猪的留言</view></view>
        <view class="quote">{{order.note || '没有留言，也想和你好好吃饭。'}}</view>
        <button hover-class="none" wx:if="{{isMine}}" class="change-entry" bindtap="go" data-page="changes">
          想换一道菜？申请更换 ›
        </button>
        <view wx:if="{{order.reply}}" class="card green">
          <view class="h4 strong">饲养员的回音</view>
          <text>{{order.reply}}</text>
        </view>
      </view>
    </view>
  </scroll-view>
  <view slot="dock" class="dock">
    <view wx:if="{{order.status==='pending'}}">
      <view wx:if="{{isCook}}" class="row">
        <button hover-class="none" class="btn secondary" bindtap="reply" data-decision="reject">这次先不做</button>
        <button hover-class="none" class="btn accent" bindtap="reply" data-decision="accept">好呀，安排上</button>
      </view>
      <button hover-class="none" wx:else class="btn ghost" bindtap="cancel">撤回这次点菜</button>
    </view>
    <button hover-class="none" wx:else class="btn" bindtap="go" data-page="today">
      <g-icon name="utensils" size="21" tone="light" />
      去看当天菜单
    </button>
  </view>
</g-shell>
<view wx:if="{{showReply}}" class="modal-mask sheet-mask" bindtap="dismissModal">
  <view class="sheet" catchtap="noop">
    <view class="sheet-title">
      <view class="h3 strong">
        {{decision==='accept'?'好呀，给你安排上':'这次先不做，也好好说'}}
      </view>
      <button hover-class="none" bindtap="closeReply">×</button>
    </view>
    <label class="form-label">
      回一句话
      <text class="caption copy small-text">选填</text>
    </label>
    <textarea
      value="{{reply}}"
      data-field="reply"
      bindinput="input"
      maxlength="300"
      placeholder="比如：好呀，今晚早点回家吃饭"
    />
    <button hover-class="none" class="btn" bindtap="confirmReply" loading="{{actionBusy}}">发送这份回音</button>
  </view>
</view>
