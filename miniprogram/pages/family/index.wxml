<wxs module="util" src="../../lib/format.wxs" />
<g-shell title="我们的小家" back="{{false}}">
  <scroll-view class="scroll" scroll-y>
    <view class="page-content page-family">
      <view wx:if="{{error}}" class="error-tip" bindtap="retry">{{error}} · 点击重试</view>
      <view class="row">
        <view class="h2">{{family.name}}</view>
        <text class="tag">{{family.role==='cook'?'饲养员':'大懒猪'}}</text>
      </view>
      <text class="muted">{{members.length}}位小猪，今天也要一起好好吃饭</text>
      <view class="card">
        <button class="list-row" bindtap="go" data-page="members">
          <text>小家成员与身份</text>
          <text>›</text>
        </button>
        <button class="list-row" bindtap="go" data-page="identity">
          <text>我的家庭称呼</text>
          <text>›</text>
        </button>
        <button class="list-row" bindtap="go" data-page="requests">
          <text>开饭回音</text>
          <text>›</text>
        </button>
        <button class="list-row" bindtap="go" data-page="home">
          <text>切换／创建其他小家</text>
          <text>›</text>
        </button>
        <button class="list-row" bindtap="go" data-page="settings">
          <text>账号与设置</text>
          <text>›</text>
        </button>
      </view>
      <view wx:if="{{family.role==='cook'}}" class="card">
        <button class="btn secondary" bindtap="go" data-page="invite" loading="{{actionBusy}}">
          <g-icon name="envelope" size="21" tone="" />
          邀请小猪回家
        </button>
        <button class="btn secondary" bindtap="go" data-page="manage" loading="{{actionBusy}}">
          <g-icon name="book" size="21" tone="" />
          菜谱与合集管理
        </button>
        <button
          class="btn secondary"
          bindtap="go"
          data-page="shareRecipes"
          loading="{{actionBusy}}"
        >
          <g-icon name="share" size="21" tone="" />
          把拿手菜分享出去
        </button>
      </view>
      <view wx:if="{{isOwner}}" class="card">
        <button class="btn secondary" bindtap="rename" loading="{{actionBusy}}">
          修改小家名称
        </button>
        <button class="btn secondary" bindtap="transfer" loading="{{actionBusy}}">
          转让创建者身份
        </button>
        <button class="btn ghost" bindtap="go" data-page="dissolve" loading="{{actionBusy}}">
          解散小家 · 全员确认
        </button>
      </view>
      <view wx:else>
        <button class="btn ghost" bindtap="leave" loading="{{actionBusy}}">退出这个小家</button>
      </view>
      <button wx:if="{{proposal}}" class="change-entry" bindtap="go" data-page="dissolve">
        查看解散申请与全员确认进度 ›
      </button>
    </view>
  </scroll-view>
  <g-tabbar slot="tabs" active="family" />
</g-shell>
