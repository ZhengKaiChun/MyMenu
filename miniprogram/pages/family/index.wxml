<wxs module="util" src="../../lib/format.wxs" />
<g-shell title="我们的小家" back="{{false}}">
  <scroll-view class="scroll" scroll-y>
    <view class="page-content page-family">
      <view wx:if="{{error}}" class="error-tip" bindtap="retry">{{error}} · 点击重试</view>
      <view class="row">
        <view class="h2">{{family.name}}</view>
        <text class="tag">{{family.role==='cook'?'饲养员':'大懒猪'}}</text>
      </view>
      <text class="muted">{{members.length}}位小猪，今天也要一起好好吃饭</text>
      <view class="card">
        <button class="list-row" bindtap="go" data-page="members">
          <view class="link-label">
            <g-icon name="people" size="25" />
            <text>小家成员与身份</text>
          </view>
          <text>›</text>
        </button>
        <button class="list-row" bindtap="go" data-page="identity">
          <view class="link-label">
            <g-icon name="user" size="25" />
            <text>我的家庭称呼</text>
          </view>
          <text>›</text>
        </button>
        <button class="list-row" bindtap="go" data-page="requests">
          <view class="link-label">
            <g-icon name="bell" size="25" />
            <text>开饭回音</text>
          </view>
          <text>›</text>
        </button>
        <button class="list-row" bindtap="go" data-page="home">
          <view class="link-label">
            <g-icon name="home" size="25" />
            <text>切换／创建其他小家</text>
          </view>
          <text>›</text>
        </button>
        <button class="list-row" bindtap="go" data-page="settings">
          <view class="link-label">
            <g-icon name="settings" size="25" />
            <text>账号与设置</text>
          </view>
          <text>›</text>
        </button>
      </view>
      <view wx:if="{{family.role==='cook'}}" class="card">
        <button class="list-row" bindtap="go" data-page="invite" loading="{{actionBusy}}">
          <view class="link-label">
            <g-icon name="envelope" size="25" />
            <text>邀请小猪回家</text>
          </view>
          <text>›</text>
        </button>
        <button class="list-row" bindtap="go" data-page="manage" loading="{{actionBusy}}">
          <view class="link-label">
            <g-icon name="book" size="25" />
            <text>菜谱与合集管理</text>
          </view>
          <text>›</text>
        </button>
        <button class="list-row" bindtap="go" data-page="shareRecipes" loading="{{actionBusy}}">
          <view class="link-label">
            <g-icon name="share" size="25" />
            <text>把拿手菜分享出去</text>
          </view>
          <text>›</text>
        </button>
      </view>
      <view wx:if="{{isOwner}}" class="card">
        <button class="list-row" bindtap="rename" loading="{{actionBusy}}">
          <view class="link-label">
            <g-icon name="edit" size="25" />
            <text>修改小家名称</text>
          </view>
          <text>›</text>
        </button>
        <button class="list-row" bindtap="transfer" loading="{{actionBusy}}">
          <view class="link-label">
            <g-icon name="key" size="25" />
            <text>转让创建者身份</text>
          </view>
          <text>›</text>
        </button>
        <button class="list-row" bindtap="go" data-page="dissolve" loading="{{actionBusy}}">
          <view class="link-label">
            <g-icon name="home" size="25" />
            <text>解散小家 · 全员确认</text>
          </view>
          <text>›</text>
        </button>
      </view>
      <view wx:else>
        <button class="list-row" bindtap="leave" loading="{{actionBusy}}">
          <view class="link-label">
            <g-icon name="door" size="25" />
            <text>退出这个小家</text>
          </view>
          <text>›</text>
        </button>
      </view>
      <button wx:if="{{proposal}}" class="change-entry" bindtap="go" data-page="dissolve">
        查看解散申请与全员确认进度 ›
      </button>
    </view>
  </scroll-view>
  <g-tabbar slot="tabs" active="family" />
</g-shell>
