<wxs module="util" src="../../lib/format.wxs"/><g-shell title="我们的小家" back="{{false}}"><scroll-view class="scroll" scroll-y><view class="page-content page-family"><view wx:if="{{error}}" class="error-tip" bindtap="retry">{{error}}</view><view class="family-house"><view class="family-welcome">三餐四季，都在这里</view><view class="h2">{{family.name}}</view><view class="family-portraits"><g-pig wx:for="{{members}}" wx:key="user_id" index="{{util.pigIndex(item.identity)}}" size="40"/><text>{{members.length}}只小猪，一起好好吃饭</text></view><g-icon class="family-house-icon" name="home" size="54"/></view><view wx:if="{{family.role==='cook'}}" class="two family-primary"><button hover-class="none" class="family-action recipe-action" bindtap="go" data-page="manage"><g-icon name="book" size="42"/><view class="h3">管理菜谱</view><text>整理拿手菜与合集</text><text class="entry-arrow">↗</text></button><button hover-class="none" class="family-action invite-action" bindtap="go" data-page="invite"><g-icon name="envelope" size="42"/><view class="h3">邀请小猪</view><text>给饭桌添一个位置</text><text class="entry-arrow">↗</text></button></view><button hover-class="none" wx:if="{{family.role==='cook'}}" class="family-share" bindtap="go" data-page="shareRecipes"><g-icon name="share" size="25"/><text class="grow">把拿手菜，装进一封信</text><text>分享菜谱 ›</text></button><view class="section-title"><view class="h3">小家的我们</view></view><view class="family-links"><button hover-class="none" class="list-row" bindtap="go" data-page="members"><view class="link-label"><g-icon name="people"/><text>成员与权限</text></view><text>›</text></button><button hover-class="none" class="list-row" bindtap="go" data-page="identity"><view class="link-label"><g-icon name="user"/><text>我的家庭称呼</text></view><text>{{family.identity}} ›</text></button></view><view class="family-secondary"><button hover-class="none" wx:if="{{isOwner}}" bindtap="rename">修改小家名</button><button hover-class="none" wx:if="{{isOwner}}" bindtap="transfer">转让创建者</button><button hover-class="none" wx:if="{{isOwner}}" bindtap="go" data-page="dissolve">解散小家</button><button hover-class="none" wx:else bindtap="leave">退出小家</button></view><button hover-class="none" wx:if="{{proposal}}" class="change-entry" bindtap="go" data-page="dissolve">查看解散确认进度 ›</button></view></scroll-view><g-tabbar slot="tabs" active="family"/></g-shell>