<wxs module="util" src="../../lib/format.wxs" />
<g-shell id="page-shell" title="确认点菜" back="{{true}}">
  <scroll-view class="scroll" scroll-y>
    <view class="page-content page-checkout">
      <view wx:if="{{error}}" class="error-tip" bindtap="retry">{{error}} · 点击重试</view>
      <view class="page-intro"><view class="h2">给这顿饭，寄个心愿</view></view>
      <button hover-class="none" class="meal-ticket row" bindtap="openDate">
        <g-icon name="calendar" size="28" />
        <view class="grow">
          <view class="strong">{{util.shortDate(date)}} · {{slot}}</view>
          <text class="small-text">用餐日期与餐次</text>
        </view>
        <text class="ticket-edit">修改 ›</text>
      </button>
      <view class="order-paper">
        <view class="row section-head">
          <view class="inline-icon-label"><g-icon name="utensils" size="20" /><text>已选菜品</text></view>
          <text class="caption copy small-text">{{count}}份</text>
        </view>
        <view wx:for="{{items}}" wx:key="id" class="order-dish row">
          <image class="food" src="{{item.cover}}" mode="aspectFill" />
          <view class="grow">
            <view class="h4 strong">{{item.name}}</view>
            <text class="caption copy small-text">{{item.minutes}}分钟 · 每份{{item.servings}}人份</text>
            <view class="order-qty">
              <button hover-class="none" data-id="{{item.id}}" data-dir="-1" bindtap="quantity"><view class="qty-symbol"/></button>
              <text class="strong">{{item.quantity}}</text>
              <button hover-class="none" data-id="{{item.id}}" data-dir="1" bindtap="quantity"><view class="qty-symbol plus"/></button>
            </view>
          </view>
        </view>
      </view>
      <view class="order-message">
        <label class="form-label">
          留言
          <text class="caption copy small-text">选填</text>
        </label>
        <textarea
          value="{{note}}"
          data-field="note"
          bindinput="input"
          placeholder="如：少盐、不放香菜"
          maxlength="300"
        />
      </view>
    </view>
  </scroll-view>
  <view slot="dock" class="dock">
    <view class="send-dock">
      <view>
        <text class="strong">已选 {{count}} 份</text>
        <text class="caption copy small-text">{{date}} · {{slot}}</text>
      </view>
      <button hover-class="none" class="btn" bindtap="submit" loading="{{actionBusy}}">
        <g-icon tone="light" name="{{family.role==='cook'?'utensils':'envelope'}}" size="22" />
        {{family.role==='cook'?'加入做饭清单':'发送吃饭申请'}}
      </button>
    </view>
  </view>
</g-shell>

<view wx:if="{{showDate}}" class="modal-mask sheet-mask" bindtap="dismissModal">
  <view class="sheet" catchtap="noop">
    <view class="sheet-title">
      <view class="h3 strong">想在哪天，好好吃饭</view>
      <button hover-class="none" class="close" bindtap="closeDate">×</button>
    </view>
    <picker mode="date" value="{{date}}" bindchange="date">
      <view class="select">{{date}} · 点这里换一天</view>
    </picker>
    <view class="meal-switch" style="margin: 16px 0">
      <button hover-class="none"
        wx:for="{{['早餐','午餐','晚餐']}}"
        wx:key="*this"
        class="{{slot===item?'active':''}}"
        data-slot="{{item}}"
        bindtap="meal"
      ><text>{{item}}</text></button>
    </view>
    <button hover-class="none" class="btn" bindtap="closeDate">
      <g-icon tone="light" name="check" size="22" />
      就这天，一起吃饭
    </button>
  </view>
</view>
