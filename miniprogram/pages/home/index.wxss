.page-home.home-empty {
  justify-content: flex-start;
  gap: 0;
  padding-bottom: 18px;
}
.home-empty .home-top {
  margin: 2px 0 17px;
}
.empty-home-illustration {
  display: flex;
  align-items: center;
  gap: 16px;
  min-height: 124px;
  padding: 17px 20px;
  margin: 0 0 19px;
  border: 1px solid #e6d4bb;
  border-radius: 24px 24px 10px 24px;
  background: #fbf0dd;
  box-shadow: 0 4px 0 #e9d9c0;
}
.empty-home-art {
  width: 92px;
  height: 86px;
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
  color: #9a7151;
}
.empty-home-art g-icon:last-child {
  position: absolute;
  right: -2px;
  bottom: -2px;
  transform: rotate(-9deg);
}
.empty-home-copy {
  display: flex;
  flex-direction: column;
  gap: 6px;
  color: #624435;
}
.empty-home-copy text:first-child {
  font-size: 15px;
  font-weight: 700;
  line-height: 1.4;
}
.empty-home-copy text:last-child {
  font-size: 11px;
  color: #a28167;
  line-height: 1.5;
}
.home-empty .section-title {
  margin: 14px 0 11px;
}
.home-empty .home-entry .quick {
  height: 150px;
  min-height: 150px;
}
.home-empty .personal-title {
  margin-top: 21px;
}
.home-empty .home-tools .list-row {
  min-height: 51px;
}
@media (max-height: 720px) {
  .empty-home-illustration {
    min-height: 94px;
    padding: 10px 16px;
    margin-bottom: 10px;
  }
  .home-empty .home-entry .quick {
    height: 128px;
    min-height: 128px;
  }
  .home-empty .personal-title {
    margin-top: 11px;
  }
}
