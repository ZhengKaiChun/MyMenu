<wxs module="util" src="../../lib/format.wxs" />
<g-shell title="菜谱与合集管理" back="{{true}}">
  <view class="page-content flush page-manage">
    <view wx:if="{{error}}" class="error-tip" bindtap="retry">{{error}} · 点击重试</view>
    <view class="manager-head">
      <view class="h2">把拿手菜，排好队</view>
      <text class="caption copy small-text">拖动把手排序；点编辑修改菜品</text>
    </view>
    <view class="manager-share-line">
      <button bindtap="go" data-page="shareRecipes">分享拿手菜 ↗</button>
    </view>
    <view class="manager-toolbar">
      <button bindtap="addCollection">
        <g-icon name="plus" size="21" />
        添加合集
      </button>
      <button bindtap="go" data-page="editDish">
        <g-icon name="book" size="21" />
        添加菜品
      </button>
    </view>
    <view class="menu-catalog manager-catalog">
      <scroll-view class="menu-rail manager-rail" scroll-y>
        <button bindtap="category" data-id="all">
          <g-icon name="utensils" />
          <text>全部</text>
        </button>
        <view
          wx:for="{{collections}}"
          wx:key="id"
          class="manager-category {{category===item.id?'active':''}}"
        >
          <button data-id="{{item.id}}" bindtap="category">
            <view
              class="drag-grip"
              data-id="{{item.id}}"
              data-type="collections"
              bindtouchstart="dragStart"
              catchtouchmove="noop"
              bindtouchend="dragEnd"
            >
              ⠿
            </view>
            <text>{{item.name}}</text>
          </button>
          <view class="cat-actions">
            <button data-id="{{item.id}}" bindtap="renameCollection">✎</button>
            <button data-id="{{item.id}}" data-dir="-1" data-type="collections" bindtap="move">
              ↑
            </button>
            <button data-id="{{item.id}}" bindtap="deleteCollection">×</button>
          </view>
        </view>
      </scroll-view>
      <scroll-view class="menu-dishes manager-dishes" scroll-y>
        <view class="catalog-label">{{dishes.length}} 道菜</view>
        <view wx:for="{{dishes}}" wx:key="id" class="menu-dish manager-dish">
          <view
            class="dish-drag drag-grip"
            data-id="{{item.id}}"
            bindtouchstart="dragStart"
            catchtouchmove="noop"
            bindtouchend="dragEnd"
          >
            ⠿
          </view>
          <image class="food" src="{{item.cover}}" mode="aspectFill" />
          <view class="grow">
            <view class="h3 strong">{{item.name}}</view>
            <text class="caption copy small-text">{{item.minutes}} 分钟</text>
            <view class="manager-actions">
              <button bindtap="go" data-page="editDish" data-id="{{item.id}}">编辑</button>
              <button bindtap="moveCollection" data-id="{{item.id}}">移动合集</button>
              <button bindtap="remove" data-id="{{item.id}}">删除</button>
            </view>
            <view class="sort-actions">
              <button bindtap="move" data-id="{{item.id}}" data-dir="-1">↑</button>
              <button bindtap="move" data-id="{{item.id}}" data-dir="1">↓</button>
            </view>
          </view>
        </view>
        <view wx:if="{{!dishes.length}}" class="empty">
          <text class="caption copy small-text">点上方“添加菜品”，写下第一道拿手菜。</text>
        </view>
      </scroll-view>
    </view>
  </view>
  <view slot="dock" class="dock">
    <view class="row">
      <button class="btn secondary" bindtap="discard">放弃修改</button>
      <button class="btn" bindtap="saveMenu" loading="{{saving}}">保存全部修改</button>
    </view>
  </view>
</g-shell>
