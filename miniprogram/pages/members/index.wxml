<wxs module="util" src="../../lib/format.wxs" />
<g-shell title="小家的每一只猪" back="{{true}}">
  <scroll-view class="scroll" scroll-y>
    <view class="page-content page-members">
      <view wx:if="{{error}}" class="error-tip" bindtap="retry">{{error}} · 点击重试</view>
      <view class="page-intro">
        <view class="h2">小家的每一位成员</view>
        <view class="muted">家庭称呼与做饭权限分别设置。</view>
      </view>
      <view wx:for="{{members}}" wx:key="user_id" class="card row">
        <g-pig index="{{item.identity==='猪爸爸'?1:item.identity==='猪妈妈'?2:7}}" size="48" />
        <view class="grow">
          <view class="h4">{{item.nickname}}</view>
          <text class="caption">{{item.identity}} · {{item.role==='cook'?'饲养员':'大懒猪'}}</text>
        </view>
        <button wx:if="{{isOwner}}" class="text-btn" data-id="{{item.user_id}}" bindtap="role">
          权限 ›
        </button>
      </view>
    </view>
  </scroll-view>
</g-shell>
