<wxs module="util" src="../../lib/format.wxs" />
<g-shell title="这份菜谱，收进哪个家？" back="{{true}}">
  <scroll-view class="scroll" scroll-y>
    <view class="page-content page-copyRecipes">
      <view wx:if="{{error}}" class="error-tip" bindtap="retry">{{error}} · 点击重试</view>
      <view class="page-intro">
        <view class="h2">给味道，找个新家</view>
        <text class="muted">{{gift.dishes.length}}道菜，含完整用料与步骤。</text>
      </view>
      <view class="copy-home-list">
        <button
          wx:for="{{homes}}"
          wx:key="id"
          class="copy-home {{target===item.id?'selected':''}}"
          bindtap="target"
          data-id="{{item.id}}"
          disabled="{{item.role!=='cook'}}"
        >
          <g-icon name="home" size="31" />
          <view class="grow">
            <view class="h4 strong">{{item.name}}</view>
            <text class="caption copy small-text">
              {{item.role==='cook'?'你可以管理':'仅吃饭身份，不能导入'}}
            </text>
          </view>
          <text>{{target===item.id?'✓':'○'}}</text>
        </button>
        <button
          class="copy-home new-home {{target==='new'?'selected':''}}"
          data-id="new"
          bindtap="target"
        >
          <g-icon name="plus" size="31" />
          <view class="grow">
            <view class="h4 strong">新建小家，并复制</view>
            <text class="caption copy small-text">复制完成后，你就是这个家的饲养员</text>
          </view>
          <text>↗</text>
        </button>
      </view>
      <view wx:if="{{target==='new'}}">
        <label class="form-label">新小家名称</label>
        <input
          class="input"
          data-field="newName"
          bindinput="input"
          value="{{newName}}"
          placeholder="给新的小家起个名字"
        />
      </view>
      <view class="section-title"><view class="h3 strong">怎么收进菜谱</view></view>
      <view class="copy-modes">
        <button class="{{mode==='add'?'selected':''}}" bindtap="mode" data-mode="add">
          <view class="h3 strong">新增</view>
          <text class="caption copy small-text">原菜保留，同名自动加后缀</text>
        </button>
        <button class="{{mode==='overwrite'?'selected':''}}" bindtap="mode" data-mode="overwrite">
          <view class="h3 strong">覆盖</view>
          <text class="caption copy small-text">确认范围后再替换</text>
        </button>
      </view>
      <view wx:if="{{mode==='overwrite'}}" class="overwrite-scope">
        <button bindtap="scope" data-scope="matching">
          {{scope==='matching'?'●':'○'}} 覆盖同名菜，其他菜保留
        </button>
        <button bindtap="scope" data-scope="whole">
          {{scope==='whole'?'●':'○'}} 整本替换，原菜单退出展示
        </button>
      </view>
      <text class="copy-impact">复制后各自编辑，不影响分享者的小家。</text>
    </view>
  </scroll-view>
  <view slot="dock" class="dock">
    <button class="btn" bindtap="preview" loading="{{actionBusy}}">
      <g-icon name="book" size="21" tone="light" />
      看一下，确认复制
    </button>
  </view>
</g-shell>
<view wx:if="{{showConfirm}}" class="modal-mask">
  <view class="modal copy-confirm">
    <view class="copy-confirm-icon"><g-icon name="book" size="34" /></view>
    <view class="h3 strong">把{{preview.count}}道味道，收进小家</view>
    <text class="copy-destination">{{preview.target}}</text>
    <view class="copy-confirm-summary">
      <view class="h4 strong">
        {{mode==='add'?'新增菜谱':scope==='whole'?'整本替换菜单':'覆盖同名菜谱'}}
      </view>
      <text>新增{{preview.added}}道 · 替换{{preview.replaced}}道</text>
      <view class="caption copy small-text">{{util.join(preview.names)}}</view>
    </view>
    <view class="muted" style="margin: 16px 0">
      {{mode==='overwrite' ? '请仔细核对替换范围，已点餐次与历史来源保留。' :
      '原有其他菜谱保留，不影响分享者的小家。'}}
    </view>
    <view class="row">
      <button class="btn secondary" bindtap="close" loading="{{actionBusy}}">再检查一下</button>
      <button class="btn accent" bindtap="commit" loading="{{actionBusy}}">
        <g-icon name="book" size="21" tone="light" />
        确认复制并保存
      </button>
    </view>
  </view>
</view>
