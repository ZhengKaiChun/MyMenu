<wxs module="util" src="../../lib/format.wxs" />
<g-shell id="page-shell" title="申请换一道菜" back="{{true}}">
  <scroll-view class="scroll" scroll-y>
    <view class="page-content page-swap">
      <view wx:if="{{error}}" class="error-tip" bindtap="retry">{{error}} · 点击重试</view>
      <view class="page-intro">
        <view class="h2">这顿，想换个口味</view>
        <text class="muted">{{util.date(source.meal_date)}} · {{source.slot}} · {{source.quantity}}份，日期与份数保持不变</text>
      </view>
      <view class="swap-original">
        <text class="caption copy small-text">原来点了</text>
        <view class="row start">
          <image class="food" src="{{source.cover}}" mode="aspectFill" />
          <view class="h3 strong">{{source.snapshot.name}}</view>
        </view>
      </view>
      <view class="section-title"><view class="h3 strong">这次想换成</view></view>
      <view class="search row"><g-icon name="search" size="20"/><input placeholder="搜索想换的菜" value="{{query}}" bindinput="search"/></view><view wx:if="{{!dishes.length}}" class="empty">没有找到这道菜</view>
      <view class="swap-options">
        <button hover-class="none"
          wx:for="{{dishes}}"
          wx:key="id"
          class="swap-option {{selected===item.id?'selected':''}}"
          data-id="{{item.id}}"
          bindtap="pick"
        >
          <image class="food" src="{{item.cover}}" mode="aspectFill" />
          <text>{{item.name}}</text>
          <text style="float: right">{{selected===item.id?'✓':'○'}}</text>
        </button>
      </view>
      <label class="form-label">想换菜的原因（选填）</label>
      <textarea
        value="{{reason}}"
        data-field="reason"
        bindinput="input"
        maxlength="300"
        placeholder="今天想换个口味，可以帮我换一道吗？"
      />
      <text class="caption copy small-text">等待或未答应时，原来的菜保持不变。</text>
    </view>
  </scroll-view>
  <view slot="dock" class="dock">
    <button hover-class="none" class="btn" bindtap="submit" loading="{{actionBusy}}">
      <g-icon name="utensils" size="21" tone="light" />
      发送换菜申请
    </button>
  </view>
</g-shell>
