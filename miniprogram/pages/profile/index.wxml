<wxs module="util" src="../../lib/format.wxs" />
<g-shell id="page-shell" title="头像与昵称" back="{{true}}">
  <scroll-view class="scroll" scroll-y>
    <view class="page-content page-profile">
      <view wx:if="{{error}}" class="error-tip" bindtap="retry">{{error}} · 点击重试</view>
      <view class="avatar-workbench"><view class="avatar-preview"><image wx:if="{{avatar}}" src="{{avatar}}" mode="aspectFill"/><g-pig wx:else index="7" size="82"/></view><view class="h3 strong">今天是哪一只小猪</view><text class="caption">选个喜欢的，也可以用自己的照片</text></view>
      <view class="avatar-picker-panel"><view class="avatar-panel-title"><text>小猪头像</text><text>8 个可选</text></view><view class="avatar-preset-grid"><button hover-class="none" wx:for="{{pigOptions}}" wx:key="*this" class="avatar-preset {{chosenPreset===item?'selected':''}}" bindtap="preset" data-index="{{item}}"><image src="/assets/avatars/pig-{{item}}.png" mode="aspectFit"/><text wx:if="{{chosenPreset===item}}" class="avatar-selected">✓</text></button></view><button hover-class="none" class="avatar-custom" bindtap="customAvatar"><g-icon name="image" size="21"/><text>从相册 / 拍照自定义</text><text>›</text></button></view>
      <label class="form-label">昵称</label>
      <input
        class="input"
        data-field="nickname"
        bindinput="input"
        value="{{nickname}}"
        placeholder="野生小猪"
        type="text"
      />
    </view>
  </scroll-view>
  <view slot="dock" class="dock">
    <button hover-class="none" class="btn" bindtap="submit" loading="{{actionBusy}}">
      <g-icon name="user" size="21" tone="light" />
      保存头像与昵称
    </button>
  </view>
</g-shell>
