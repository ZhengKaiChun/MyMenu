<wxs module="util" src="../../lib/format.wxs" />
<g-shell title="三个月的好好吃饭" back="{{true}}">
  <scroll-view class="scroll" scroll-y>
    <view class="page-content page-history">
      <view wx:if="{{error}}" class="error-tip" bindtap="retry">{{error}} · 点击重试</view>
      <view class="page-intro">
        <view class="overline">TASTE THE MEMORIES</view>
        <view class="h2">有些日子，一想就很香</view>
        <text class="copy muted">仅保留最近 3 个自然月的餐次记录。</text>
      </view>
      <view class="card">
        <view class="row">
          <button hover-class="none" class="text-btn" data-dir="-1" bindtap="month">‹</button>
          <text class="strong">{{calendarYear}} 年 {{calendarMonth}} 月</text>
          <button hover-class="none" class="text-btn" data-dir="1" bindtap="month">›</button>
        </view>
        <view class="calendar history-calendar">
          <view wx:for="{{weekLabels}}" wx:key="*this" class="weekday">{{item}}</view>
          <block wx:for="{{cells}}" wx:key="id">
            <view wx:if="{{item.blank}}" />
            <button hover-class="none"
              wx:else
              class="{{item.on?'on':''}} {{item.dot?'dot':''}}"
              data-date="{{item.date}}"
              bindtap="selectDate"
            >
              {{item.day}}
            </button>
          </block>
        </view>
      </view>
      <view class="row">
        <view class="h3 strong">{{calendarMonth}} 月 {{calendarDay}} 日 · 饭桌回忆</view>
        <text class="tag good">已吃到</text>
      </view>
      <block wx:for="{{sections}}" wx:key="slot" wx:for-item="meal">
        <view wx:for="{{meal.dishes}}" wx:key="dishId" class="dish">
          <image class="food" src="{{item.cover}}" mode="aspectFill" />
          <view class="grow">
            <view class="h4 strong">{{item.snapshot.name}}</view>
            <text class="caption copy small-text">{{item.quantity}}份 · 一起好好吃饭</text>
            <text class="tag">{{meal.slot}}</text>
          </view>
          <button hover-class="none"
            wx:if="{{isCook}}"
            class="text-btn"
            data-page="recipe"
            data-id="{{item.dishId}}"
            bindtap="go"
          >
            做法 ›
          </button>
        </view>
      </block>
      <view wx:if="{{!total}}" class="history-empty">
        这一天还没有标记“已吃到”的菜，留一点期待。
      </view>
    </view>
  </scroll-view>
  <g-tabbar slot="tabs" active="today" />
</g-shell>
