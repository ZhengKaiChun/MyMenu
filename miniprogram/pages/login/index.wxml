<g-shell id="page-shell" title="给我饭" back="{{false}}">
  <scroll-view class="scroll" scroll-y>
    <view class="page-content page-login">
      <view wx:if="{{error}}" class="error-tip" bindtap="retry">{{error}} · 点击重试</view>
      <view class="login-brand">
        <text class="brand-sub">两个人的点菜小厨房</text>
        <view class="h2 wordmark">给我饭</view>
        <text class="copy login-slogan">你说想吃什么，我说好呀。</text>
      </view>
      <view class="welcome-visual"><image src="/assets/pig-kitchen.png" mode="aspectFit" /></view>
      <view class="login-actions">
        <button hover-class="none" class="btn" bindtap="wechat"><g-icon tone="light" name="key" size="21"/>微信一键登录</button>
        <button hover-class="none" class="btn secondary" bindtap="go" data-page="sms">手机号登录 / 注册</button>
        <button hover-class="none" class="text-btn" bindtap="go" data-page="password">账号密码登录<text>›</text></button>
      </view>
      <checkbox-group bindchange="consent">
        <label class="checkline login-consent">
          <checkbox value="yes" checked="{{consent}}" color="#b74f37" />
          <view class="consent-copy">
            <view>
              已阅读并同意
              <text bindtap="legal">服务协议</text>
              和
              <text bindtap="legal">隐私说明</text>
            </view>
            <text class="small-text">{{capabilities.preview?'本机预览仅演示登录，不进行微信认证或发送短信':'首次登录将创建独立账号'}}</text>
          </view>
        </label>
      </checkbox-group>
    </view>
  </scroll-view>
</g-shell>
