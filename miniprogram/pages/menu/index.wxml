<wxs module="util" src="../../lib/format.wxs" />
<g-shell id="page-shell" title="给我饭" back="{{true}}">
  <view class="page-content flush page-menu">
    <view wx:if="{{error}}" class="error-tip" bindtap="retry">{{error}} · 点击重试</view>
    <view class="menu-heading"><text class="h3 grow strong">小家菜单</text><text class="menu-family-label">{{family.name}}</text></view>
    <view class="menu-search">
      <view class="search row">
        <g-icon name="search" size="20" />
        <input placeholder="搜索菜名" bindinput="search" value="{{search}}" />
      </view>
    </view>
    <view class="menu-schedule">
      <picker mode="date" value="{{date}}" bindchange="date">
        <view class="date-trigger native-date">
          <g-icon name="calendar" size="21" />
          <text>{{util.shortDate(date)}} ⌄</text>
        </view>
      </picker>
      <view class="meal-switch">
        <button hover-class="none"
          wx:for="{{['早餐','午餐','晚餐']}}"
          wx:key="*this"
          class="{{slot===item?'active':''}}"
          bindtap="meal"
          data-slot="{{item}}"
        ><text>{{item}}</text></button>
      </view>
      <button hover-class="none" class="menu-inbox" bindtap="go" data-page="requests"><g-icon name="bell" /></button>
    </view>
    <view wx:if="{{showMeatTabs}}" class="meat-fixed-tabs"><button hover-class="none" wx:for="{{meatTypes}}" wx:key="*this" bindtap="meatCategory" data-type="{{item}}" class="{{meatType===item?'active':''}}">{{item}}</button></view>
    <view class="menu-catalog">
      <scroll-view class="menu-rail" scroll-y>
        <button hover-class="none"
          wx:for="{{collections}}"
          wx:key="id"
          class="{{category===item.id?'active':''}}"
          bindtap="category"
          data-id="{{item.id}}"
        >
          <g-icon name="{{index%3===0?'pot':index%3===1?'leaf':'bowl'}}" size="27" />
          <text class="strong rail-label">{{item.name}}</text>
        </button>
      </scroll-view>
      <scroll-view class="menu-dishes" scroll-y>
        <view class="catalog-label">
          <text>{{category==='all'?'全部菜品':categoryName}}</text>
          <text>{{dishes.length}} 道</text>
        </view>
        <view wx:for="{{dishes}}" wx:key="id" class="menu-dish"><g-icon wx:if="{{item.featured}}" class="featured-star" name="star" size="20"/>
          <button hover-class="none" class="menu-photo" bindtap="go" data-page="dish" data-id="{{item.id}}">
            <image class="food" src="{{item.cover}}" mode="aspectFill" />
          </button>
          <view class="menu-dish-info">
            <button hover-class="none" class="h3 strong" bindtap="go" data-page="dish" data-id="{{item.id}}">
              {{item.name}}
            </button>
            <view class="copy dish-description">{{item.intro}}</view>
            <view class="dish-order-row">
              <view class="dish-facts">
                <view class="dish-meta">
                  <text class="tag">{{item.minutes}} 分钟</text>
                  <text class="tag">{{item.servings}} 人份</text>
                </view>
                <view class="dish-spice"><g-icon wx:for="{{[1,2,3]}}" wx:for-item="level" wx:key="*this" name="{{level<=item.spiceLevel?'chili':'chili-outline'}}" size="15"/></view>
              </view>
              <button hover-class="none" class="dish-add" bindtap="add" data-id="{{item.id}}">
                <text wx:if="{{quantities[item.id]}}" class="strong">{{quantities[item.id]}}</text>
                <text wx:if="{{quantities[item.id]}}">＋</text>
                <block wx:else><g-icon name="bowl" size="20"/><text>想吃</text></block>
              </button>
            </view>
          </view>
        </view>
        <view wx:if="{{!dishes.length}}" class="empty">
          <g-icon name="book" size="45" />
          <view class="h3 strong">这里还没有菜</view>
          <text class="caption copy small-text">{{family.role==='cook'?'去小家里的菜谱管理添加第一道拿手菜':'等饲养员录入菜品后，就能点菜啦'}}</text>
        </view>
      </scroll-view>
    </view>
  </view>
  <view slot="dock" class="dock dock-menu">
    <view class="basket-bar">
      <button hover-class="none" class="basket-count" bindtap="cart">
        <g-icon name="basket" size="28" tone="light" />
        <text wx:if="{{count}}" class="basket-badge">{{count}}</text>
      </button>
      <button hover-class="none" class="basket-summary" bindtap="cart">
        <text class="strong">{{count?'已选 '+count+' 份':'选几道想吃的菜'}}</text>
        <text class="caption copy small-text">{{util.shortDate(date)}} · {{slot}}</text>
      </button>
      <button hover-class="none" class="btn small" bindtap="checkout">
        <g-icon name="check" size="18" />
        确认点菜
      </button>
    </view>
  </view>
  <g-tabbar slot="tabs" active="menu" />
</g-shell>
<view wx:if="{{showCart}}" class="modal-mask sheet-mask" bindtap="dismissModal">
  <view class="sheet" catchtap="noop">
    <view class="sheet-title">
      <view class="h3 strong">小猪的菜篮</view>
      <button hover-class="none" class="close" bindtap="cart">×</button>
    </view>
    <scroll-view scroll-y style="height:{{cart.length > 4 ? 340 : cart.length * 76}}px;max-height:45vh">
      <view wx:for="{{cart}}" wx:key="id" class="row list-row cart-dish">
        <image class="food" src="{{item.cover}}" mode="aspectFill" />
        <text class="grow">{{item.name}}</text>
        <view class="row">
          <button hover-class="none" class="pill" bindtap="minus" data-id="{{item.id}}"><view class="qty-symbol"/></button>
          <text>{{item.quantity}}</text>
          <button hover-class="none" class="pill" bindtap="add" data-id="{{item.id}}"><view class="qty-symbol plus"/></button>
        </view>
      </view>
    </scroll-view>
    <text wx:if="{{!cart.length}}" class="caption copy small-text">还没选菜，去挑一道喜欢的吧。</text>
    <button hover-class="none" class="btn" bindtap="checkout">
      <g-icon name="check" size="21" tone="" />
      确认日期和菜品
    </button>
  </view>
</view>
