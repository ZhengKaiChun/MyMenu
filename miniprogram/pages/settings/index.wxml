<wxs module="util" src="../../lib/format.wxs" />
<g-shell title="我的与设置" back="{{true}}">
  <scroll-view class="scroll" scroll-y>
    <view class="page-content page-settings">
      <view wx:if="{{error}}" class="error-tip" bindtap="retry">{{error}} · 点击重试</view>
      <view class="card profile-pass row">
        <image
          wx:if="{{user.avatar}}"
          src="{{user.avatar}}"
          mode="aspectFill"
          style="width: 68px; height: 68px; border-radius: 50%"
        />
        <g-pig wx:else index="7" size="68" />
        <view>
          <view class="h2">{{user.nickname}}</view>
          <button hover-class="none" class="text-btn" bindtap="go" data-page="profile">修改头像与昵称 ›</button>
        </view>
      </view>
      <view class="card">
        <button hover-class="none"
          wx:if="{{capabilities.wechat && !capabilities.preview}}"
          class="list-row"
          bindtap="bindWechat"
        >
          <text>绑定微信身份</text>
          <text>›</text>
        </button>
        <button hover-class="none"
          wx:if="{{capabilities.subscriptionTemplateId}}"
          class="list-row"
          bindtap="subscribe"
        >
          <text>开饭订阅提醒</text>
          <text>按需订阅 ›</text>
        </button>
        <view wx:else class="list-row">
          <text>开饭通知</text>
          <text class="caption copy small-text">站内回音已开启</text>
        </view>
      </view>
<view class="settings-tools"><button hover-class="none" class="list-row" bindtap="go" data-page="personal"><view class="link-label"><g-icon name="basket"/><text>个人现有食材</text></view><text>›</text></button><button hover-class="none" class="list-row" bindtap="go" data-page="history"><view class="link-label"><g-icon name="calendar"/><text>最近三个月的吃饭记录</text></view><text>›</text></button></view>      <button hover-class="none" wx:if="{{capabilities.sms}}" class="btn secondary" bindtap="bindPhone">
        绑定／修改手机号
      </button>
<view class="row settings-actions"><button hover-class="none" class="btn logout-red" bindtap="logout">退出登录</button><button hover-class="none" class="btn ghost" bindtap="deleteAccount">注销账号</button></view>
    </view>
  </scroll-view>
</g-shell>
