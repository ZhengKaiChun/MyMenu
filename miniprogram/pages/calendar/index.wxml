<wxs module="util" src="../../lib/format.wxs" />
<g-shell title="我们的小家饭历" back="{{true}}">
  <scroll-view class="scroll" scroll-y>
    <view class="page-content page-calendar">
      <view wx:if="{{error}}" class="error-tip" bindtap="retry">{{error}} · 点击重试</view>
      <view class="row">
        <view>
          <view class="overline">DAYS TASTE BETTER TOGETHER</view>
          <view class="h2">每一天，都好好吃饭。</view>
        </view>
        <button hover-class="none" class="text-btn" bindtap="go" data-page="history">回味 ›</button>
      </view>
      <view class="datebar">
        <button hover-class="none"
          wx:for="{{weekDays}}"
          wx:key="date"
          class="date {{item.on?'on':''}}"
          bindtap="selectDate"
          data-date="{{item.date}}"
        >
          <text>{{item.label}}</text>
          <text class="strong">{{item.day}}</text>
        </button>
        <picker mode="date" value="{{date}}" bindchange="date">
          <view class="date">
            <text>更多</text>
            <text class="strong">⌄</text>
          </view>
        </picker>
      </view>
      <view class="row">
        <text class="strong">{{date}} 的小饭桌</text>
        <text class="tag good">全家共享</text>
      </view>
      <view wx:for="{{sections}}" wx:key="slot" wx:for-item="meal" class="today-meal">
        <view class="row" style="border-bottom: 1px solid #ddc7a4; padding-bottom: 9px">
          <g-icon
            name="{{meal.slot==='早餐'?'bowl':meal.slot==='午餐'?'utensils':'pot'}}"
            size="23"
          />
          <view class="h3 grow strong">{{meal.slot}}</view>
          <text class="caption copy small-text">{{meal.dishes.length}}道菜</text>
        </view>
        <view
          wx:for="{{meal.dishes}}"
          wx:key="dishId"
          class="today-dish"
          bindtap="openRecipe"
          data-id="{{item.dishId}}"
        >
          <image class="food" src="{{item.cover}}" mode="aspectFill" />
          <view class="grow">
            <view class="h4 strong">{{item.snapshot.name}}</view>
            <view class="orderer-list">
              <view wx:for="{{item.sources}}" wx:key="id" wx:for-item="source" class="orderer-chip">
                <g-pig index="{{source.pig}}" size="26" />
                <text>{{source.identity}}</text>
              </view>
            </view>
            <text class="caption copy small-text">合计{{item.quantity}}份</text>
          </view>
          <button hover-class="none"
            wx:if="{{item.ownLineId}}"
            class="text-btn swap-button"
            catchtap="swapDish"
            data-id="{{item.ownLineId}}"
          >
            换菜
          </button>
        </view>
        <view wx:if="{{!meal.dishes.length}}" class="today-empty">这顿还没安排，去点一道吧。</view>
      </view>
    </view>
  </scroll-view>
  <view slot="dock" class="dock dock-with-tabs">
    <button hover-class="none" wx:if="{{isCook}}" class="btn" bindtap="prep">
      <g-icon tone="light" name="basket" size="22" />
      准备这一天的食材
    </button>
    <button hover-class="none" wx:else class="btn" bindtap="go" data-page="menu">
      <g-icon name="utensils" size="21" tone="light" />
      我也来点一道
    </button>
  </view>
  <g-tabbar slot="tabs" active="today" />
</g-shell>
