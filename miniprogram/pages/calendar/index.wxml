<wxs module="util" src="../../lib/format.wxs"/>
<g-shell id="page-shell" title="小家饭历" back="{{true}}"><view class="diary-page"><view wx:if="{{error}}" class="error-tip" bindtap="retry">{{error}}</view>
<view class="diary-calendar"><view class="diary-intro"><view><text class="diary-eyebrow">OUR TABLE, OUR DAYS</text><view class="h2">把日子，吃成回忆</view></view><g-icon name="calendar" size="32"/></view><view class="diary-month"><button hover-class="none" disabled="{{!canPrev}}" bindtap="month" data-dir="-1">‹</button><view>{{year}} 年 <text>{{month}} 月</text></view><button hover-class="none" disabled="{{!canNext}}" bindtap="month" data-dir="1">›</button></view><view class="diary-week"><text wx:for="{{weekLabels}}" wx:key="*this">{{item}}</text></view><view class="diary-days"><view wx:for="{{cells}}" wx:key="id" class="diary-cell {{item.on?'on':''}} {{item.disabled?'disabled':''}}" data-date="{{item.date}}" bindtap="selectDate"><text wx:if="{{!item.blank}}">{{item.day}}</text><view wx:if="{{item.dot}}" class="diary-dot"/></view></view><text class="diary-retention">只记录已经过去的日子 · 最近三个月</text></view>
<view class="diary-meals"><view class="diary-selected"><text>{{util.shortDate(date)}} 的饭桌</text><text>左右翻翻，看看吃过什么</text></view><view class="diary-meal-tabs"><button hover-class="none" wx:for="{{sections}}" wx:key="slot" data-slot="{{item.slot}}" bindtap="meal" class="{{slot===item.slot?'active':''}}">{{item.slot}}<text>{{item.dishes.length}}</text></button></view><swiper wx:if="{{displayDishes.length}}" class="diary-dishes" next-margin="{{displayDishes.length>1?'24px':'0px'}}" indicator-dots="{{displayDishes.length>1}}" indicator-color="#e4d4b9" indicator-active-color="#ad7751"><swiper-item wx:for="{{displayDishes}}" wx:key="dishId"><view class="diary-dish"><image src="{{item.cover}}" mode="aspectFill"/><view><text class="diary-dish-name">{{item.name}}</text><text class="diary-quantity">{{item.quantity}} 份 · {{slot}}</text></view><view class="diary-orderers"><text wx:for="{{item.sources}}" wx:for-item="source" wx:key="id">{{source.identity}}{{source.quantity>1?'×'+source.quantity:''}}</text></view></view></swiper-item></swiper><view wx:else class="diary-empty"><g-icon name="bowl" size="34"/><view>这顿没有留下记录</view><text>一起吃过的饭，会慢慢装满这里</text></view></view>
</view><g-tabbar slot="tabs" active="today"/></g-shell>
