<wxs module="util" src="../../lib/format.wxs"/><g-shell id="page-shell" title="记录我的掌勺" back="{{true}}"><view class="cooking-fixed"><view class="cooking-head"><view class="h2">这一餐，我做了</view><text class="caption">{{family.name}} · 勾选自己实际做的菜</text><view class="row cooking-schedule"><picker mode="date" value="{{date}}" start="{{minDate}}" end="{{maxDate}}" bindchange="date"><view class="date-trigger"><g-icon name="calendar" size="20"/><text>{{util.shortDate(date)}} ⌄</text></view></picker><view class="meal-switch"><button hover-class="none" wx:for="{{['早餐','午餐','晚餐']}}" wx:key="*this" class="{{slot===item?'active':''}}" bindtap="meal" data-slot="{{item}}"><text>{{item}}</text></button></view></view><view class="row"><text class="caption">已选 {{selected.length}} 道</text><button hover-class="none" class="text-btn" bindtap="all">{{all?'取消全选':'全选本餐'}}</button></view><view wx:if="{{error}}" class="error-tip">{{error}}</view></view>
<scroll-view scroll-y class="cooking-list"><checkbox-group bindchange="select"><label wx:for="{{dishes}}" wx:key="id" class="cooking-dish"><image src="{{item.cover}}" mode="aspectFill"/><text class="grow strong">{{item.name}}</text><checkbox value="{{item.id}}" checked="{{util.contains(selected,item.id)}}" color="#8c986c"/></label></checkbox-group><view wx:if="{{!dishes.length}}" class="empty"><g-icon name="bowl" size="42"/><view>这餐还没有安排菜品</view><text class="caption">换个日期或餐次看看</text></view></scroll-view></view><view slot="dock" class="dock"><button hover-class="none" class="btn" bindtap="submit" loading="{{actionBusy}}">保存我的掌勺记录</button></view></g-shell>