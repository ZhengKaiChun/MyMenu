<wxs module="util" src="../../lib/format.wxs" />
<g-shell id="page-shell" title="全家今日菜单" back="{{false}}">
  <scroll-view class="scroll" scroll-y>
    <view class="page-content page-today">
      <view wx:if="{{error}}" class="error-tip" bindtap="retry">{{error}} · 点击重试</view>
      <view class="today-heading">
        <view>
          <text class="caption copy small-text">OUR DAILY TABLE</text>
          <view class="h2">今天，全家吃什么</view>
        </view>
        <button hover-class="none" class="text-btn" bindtap="go" data-page="calendar">饭历 ›</button>
      </view>
      <picker mode="date" value="{{date}}" bindchange="date">
        <view class="today-date">
          <g-icon name="calendar" size="22" />
          <text class="grow strong">{{date}}</text>
          <text>换一天 ⌄</text>
        </view>
      </picker>

      <view wx:if="{{isCook && isToday}}" class="cooking-inline-hint"><g-icon name="check" size="16"/><text>勾选自己做完的菜，明天计入成就</text></view>
      <view wx:for="{{sections}}" wx:key="slot" wx:for-item="meal" class="today-meal">
        <view
          class="row section-head"
          style="border-bottom: 1px solid #ddc7a4; padding-bottom: 9px"
        >
          <g-icon
            name="{{meal.slot==='早餐'?'bowl':meal.slot==='午餐'?'utensils':'pot'}}"
            size="23"
          />
          <view class="h3 grow strong">{{meal.slot}}</view>
          <text class="caption copy small-text">{{meal.dishes.length}}道菜</text>
        </view>
        <view
          wx:for="{{meal.dishes}}"
          wx:key="dishId"
          class="today-dish"
          bindtap="openRecipe"
          data-id="{{item.dishId}}"
        >
          <image class="food" src="{{item.cover}}" mode="aspectFill" />
          <view class="grow">
            <view class="h4 strong">{{item.snapshot.name}}</view>
            <view class="orderer-list">
              <view wx:for="{{item.displaySources}}" wx:key="id" wx:for-item="source" class="orderer-chip">
                <g-pig index="{{source.pig}}" size="26" />
                <text>{{source.identity}}{{source.quantity>1?'×'+source.quantity:''}}</text>
              </view>
            </view>
            <text class="caption copy small-text">合计{{item.quantity}}份</text>
          </view>
          <view class="today-dish-actions">
            <view class="today-complete-slot">
              <button hover-class="none" wx:if="{{item.canMark}}" class="cook-check {{item.cooker?'checked':''}}" catchtap="toggleCook" data-id="{{item.dishId}}" data-slot="{{meal.slot}}"><view class="cook-check-box">{{item.cooker?'✓':''}}</view><text>已做完</text></button>
              <view wx:elif="{{item.cooker}}" class="cook-completed"><view class="cook-check-box">✓</view><text>已做完</text></view>
            </view>
            <view class="today-swap-slot"><button hover-class="none" wx:if="{{item.ownLineId && !item.cooker}}" class="text-btn swap-button" catchtap="swapDish" data-id="{{item.ownLineId}}">换菜</button></view>
          </view>
        </view>
        <view wx:if="{{!meal.dishes.length}}" class="today-empty">这顿还没安排，去点一道吧。</view>
      </view>
    </view>
  </scroll-view>
  <view slot="dock" class="dock dock-with-tabs">
    <button hover-class="none" wx:if="{{isCook}}" class="btn" bindtap="prep">
      <g-icon tone="light" name="basket" size="22" />
      去备菜 · 汇总当天食材
    </button>
    <button hover-class="none" wx:else class="btn" bindtap="go" data-page="menu">
      <g-icon name="utensils" size="21" tone="light" />
      我也来点菜
    </button>
  </view>
  <g-tabbar slot="tabs" active="today" />
</g-shell>
