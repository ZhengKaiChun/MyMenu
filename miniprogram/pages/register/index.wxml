<wxs module="util" src="../../lib/format.wxs" />
<g-shell title="注册独立账号" back="{{true}}">
  <scroll-view class="scroll" scroll-y>
    <view class="page-content page-register">
      <view wx:if="{{error}}" class="error-tip" bindtap="retry">{{error}} · 点击重试</view>
      <view class="page-intro">
        <view class="h2">给小猪，一个专属账号</view>
        <view class="muted">注册成功后直接选择创建或加入小家。</view>
      </view>
      <label class="form-label">账号</label>
      <input
        class="input"
        data-field="username"
        bindinput="input"
        value="{{username}}"
        placeholder="4–32 位字母、数字或下划线"
        type="text"
      />
      <label class="form-label">密码</label>
      <input
        class="input"
        data-field="password"
        bindinput="input"
        value="{{password}}"
        placeholder="至少10位，建议使用独特的长密码"
        password="true"
      />
      <label class="form-label">确认密码</label>
      <input
        class="input"
        data-field="confirm"
        bindinput="input"
        value="{{confirm}}"
        placeholder="再次输入密码"
        password="true"
      />
      <checkbox-group bindchange="consent">
        <label class="checkline login-consent">
          <checkbox value="yes" checked="{{consent}}" />
          <text>已阅读并同意服务协议与隐私说明</text>
        </label>
      </checkbox-group>
      <button class="btn" bindtap="submit" loading="{{actionBusy}}">注册并进入</button>
    </view>
  </scroll-view>
</g-shell>
