<wxs module="util" src="../../lib/format.wxs" />
<g-shell id="page-shell" title="小家的秘密配方" back="{{true}}">
  <scroll-view scroll-y class="scroll">
    <view class="page-content page-recipe">
      <view wx:if="{{error}}" class="error-tip" bindtap="retry">{{error}} · 点击重试</view>
      <view class="row">
        <view class="h2">{{dish.name}}</view>
        <button hover-class="none" class="pill" bindtap="toggle">{{textOnly?'图文版':'纯文字'}}</button>
      </view>
      <text class="muted">{{dish.minutes}} 分钟 · {{dish.servings}} 人份</text>
      <image webp="{{true}}" wx:if="{{!textOnly}}" src="{{dish.cover}}" class="food mid" mode="aspectFill" />
      <view class="section-title"><view class="h3 strong">用料</view></view>
      <view wx:for="{{dish.ingredients}}" wx:key="index" class="list-row">
        <text>{{item.name}}</text>
        <text>{{item.quantity}} {{item.unit}}</text>
      </view>
      <view class="section-title"><view class="h3 strong">一步一步，把爱煮好</view></view>
      <view class="recipe-focus"><button hover-class="none" class="{{importantOnly?'active':''}}" bindtap="focusSteps">{{importantOnly?'查看全部步骤':'只看重点步骤'}}</button><text>{{importantOnly?visibleSteps.length+' 个重点步骤':dish.steps.length+' 个步骤'}}</text></view>
      <view wx:if="{{importantOnly&&!visibleSteps.length}}" class="option-hint">这道菜还没有标记重点步骤。</view>
      <view class="steps">
        <view wx:for="{{visibleSteps}}" wx:key="index" class="step">
          <text class="step-num">STEP {{item.number}} {{item.important?'★ 重点':''}}</text>
          <image webp="{{true}}"
            wx:if="{{!textOnly ? item.image : false}}"
            src="{{item.image}}"
            class="step-photo"
            mode="scaleToFill"
          />
          <view style="font-size: 14px; line-height: 1.95; margin-top: 10px">{{item.text || (textOnly?'这一步是图片说明，请切换图文版查看':'')}}</view>
        </view>
      </view>
    </view>
  </scroll-view>
</g-shell>
