<wxs module="util" src="../../lib/format.wxs" />
<g-shell id="page-shell" title="写下一道拿手菜" back="{{true}}">
  <scroll-view scroll-y="{{!showCollectionPicker}}" class="scroll">
    <view class="page-content page-editDish">
      <view wx:if="{{error}}" class="error-tip" bindtap="retry">{{error}} · 点击重试</view>
      <view class="h2">写下小家的拿手菜</view>
      <label class="form-label">菜品名称 *</label>
      <input
        class="input"
        value="{{name}}"
        data-field="name"
        bindinput="input"
        type="text"
        placeholder="例如：番茄炒蛋"
      />
      <view class="cover-heading"><label class="form-label">菜品封面</label><button hover-class="none" class="text-btn" bindtap="ai">✧ AI优化图片</button></view>
      <button hover-class="none" class="upload cover-upload" bindtap="picture" data-kind="cover" style="width: 100%">
        <image
          wx:if="{{cover}}"
          src="{{cover}}"
          mode="aspectFill"
          style="width: 100%; height: 144px"
        />
        <view wx:else class="upload-placeholder"><g-icon name="image" size="29"/><text>添加菜品图片</text></view>
      </button>
      <view class="collection-select-heading"><label class="form-label">所属合集</label><text>可多选</text></view>
      <button hover-class="none" class="collection-entry" bindtap="openCollections">
        <view class="collection-entry-icon"><g-icon name="book" size="24"/></view>
        <view class="collection-entry-copy"><text>{{collectionSummary || '为这道菜选择合集'}}</text><text>{{collectionIds.length?'已选 '+collectionIds.length+' 个合集':'点击选择，至少一个'}}</text></view>
        <text class="collection-entry-arrow">›</text>
      </button>
      <view wx:if="{{needsMeatType}}" class="editor-meat"><label class="form-label">肉类小分类 *</label><view class="meat-fixed-tabs"><button hover-class="none" wx:for="{{meatTypes}}" wx:key="*this" bindtap="meat" data-type="{{item}}" class="{{meatType===item?'active':''}}">{{item}}</button></view></view>
      <view class="two">
        <view>
          <label class="form-label">用时／分钟</label>
          <input
            class="input"
            value="{{minutes}}"
            data-field="minutes"
            bindinput="input"
            type="number"
            placeholder="15"
          />
        </view>
        <view>
          <label class="form-label">份量／人</label>
          <input
            class="input"
            value="{{servings}}"
            data-field="servings"
            bindinput="input"
            type="number"
            placeholder="2"
          />
        </view>
      </view>
      <view class="dish-preferences"><view class="featured-toggle"><view><text class="strong">设为招牌菜</text><text>在小家菜单里亮一颗星</text></view><switch color="#caab58" checked="{{featured}}" bindchange="featured"/></view><view class="spice-heading"><text class="strong">这道菜的辣度</text><text>默认微辣</text></view><view class="spice-options"><button hover-class="none" wx:for="{{['微辣','中辣','特辣']}}" wx:key="*this" class="{{spiceLevel===index+1?'active':''}}" bindtap="spice" data-level="{{index+1}}"><g-icon name="chili" size="18"/><text>{{item}}</text></button></view></view>
      <label class="form-label">一句话介绍</label>
      <input
        class="input"
        value="{{intro}}"
        data-field="intro"
        bindinput="input"
        type="text"
        placeholder="比如：酸酸甜甜，家的味道"
      />
      <view class="section-title">
        <view class="h3 strong">用料</view>
        <button hover-class="none" class="add-row-btn" bindtap="addIngredient">＋ 添加用料</button>
      </view>
      <view wx:for="{{ingredients}}" wx:key="index" class="row" style="margin: 8px 0; gap: 7px">
        <input
          class="input"
          style="flex: 2"
          value="{{item.name}}"
          data-list="ingredients"
          data-index="{{index}}"
          data-field="name"
          bindinput="field"
          placeholder="食材"
        />
        <input
          class="input"
          style="flex: 1"
          value="{{item.quantity}}"
          type="digit"
          data-list="ingredients"
          data-index="{{index}}"
          data-field="quantity"
          bindinput="field"
          placeholder="数量"
        />
        <input
          class="input"
          style="flex: 1"
          value="{{item.unit}}"
          data-list="ingredients"
          data-index="{{index}}"
          data-field="unit"
          bindinput="field"
          placeholder="单位"
        />
        <button hover-class="none" class="text-btn" data-index="{{index}}" bindtap="removeIngredient">×</button>
      </view>
      <view class="section-title">
        <view class="h3 strong">制作步骤</view>
        <text class="caption copy small-text">步骤图选填</text>
      </view>
      <view wx:for="{{steps}}" wx:key="index" class="step">
        <view class="row">
          <text class="step-num">步骤 {{index+1}}</text>
          <button hover-class="none" class="text-btn" data-index="{{index}}" bindtap="removeStep">删除此步</button>
        </view>
        <button hover-class="none"
          class="upload"
          bindtap="picture"
          data-kind="step"
          data-index="{{index}}"
          style="width: 100%"
        >
          <image wx:if="{{item.image}}" class="step-photo" src="{{item.image}}" mode="scaleToFill" />
          <view wx:else class="upload-placeholder"><g-icon name="image" size="26"/><text>添加步骤图 · 选填</text></view>
        </button>
        <textarea
          class="native-textarea"
          value="{{item.text}}"
          data-list="steps"
          data-index="{{index}}"
          data-field="text"
          bindinput="field"
          placeholder="写下这一步的做法"
          style="margin-top: 10px"
        />
      </view>
      <button hover-class="none" class="add-step-btn" bindtap="addStep">＋ 添加下一步</button>
    </view>
  </scroll-view>
  <view slot="dock" class="dock">
    <button hover-class="none" class="btn" bindtap="save" loading="{{actionBusy}}">
      <g-icon name="book" size="21" tone="light" />
      保存到小家菜单
    </button>
  </view>
</g-shell>

<view wx:if="{{showCollectionPicker}}" class="modal-mask collection-mask" bindtap="closeCollections">
  <view class="collection-sheet" catchtap="noop">
    <view class="collection-sheet-head">
      <view class="collection-folder-icon"><g-icon name="book" size="29"/></view>
      <view class="grow"><view class="h3 strong">放进喜欢的合集</view><text>一道菜，也可以有几个位置</text></view>
      <button hover-class="none" class="collection-close" bindtap="closeCollections">×</button>
    </view>
    <view class="collection-search"><g-icon name="search" size="19"/><input placeholder="搜索合集名称" value="{{collectionSearch}}" bindinput="searchCollections"/></view>
    <view class="collection-list-caption"><text>{{collectionOptions.length}} 个合集</text><text>可多选</text></view>
    <scroll-view scroll-y class="collection-options" style="height:{{collectionOptions.length>5?280:collectionOptions.length*53+12}}px">
      <button hover-class="none" wx:for="{{collectionOptions}}" wx:key="id" class="collection-option {{util.contains(draftCollectionIds,item.id)?'selected':''}}" bindtap="collection" data-id="{{item.id}}">
        <g-icon name="book" size="19"/><text class="collection-option-name">{{item.name}}</text><view class="collection-option-check">{{util.contains(draftCollectionIds,item.id)?'✓':''}}</view>
      </button>
      <view wx:if="{{!collectionOptions.length}}" class="collection-no-results">没有找到，换个名字试试</view>
    </scroll-view>
    <view class="collection-sheet-footer"><view><text>已选 {{draftCollectionIds.length}} 个</text><text>确认选择后，记得保存菜品</text></view><button hover-class="none" class="btn" disabled="{{!draftCollectionIds.length}}" bindtap="confirmCollections">确认选择</button></view>
  </view>
</view>
