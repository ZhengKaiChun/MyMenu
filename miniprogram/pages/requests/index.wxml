<wxs module="util" src="../../lib/format.wxs"/>
<g-shell id="page-shell" title="小家的消息" back="{{true}}"><view class="inbox-page">
<view class="inbox-heading"><view><view class="h2">开饭有回音</view><text>饭桌上的心愿，都有着落</text></view><g-icon name="envelope" size="38"/></view>
<view class="inbox-tabs"><button hover-class="none" wx:for="{{noteTabs}}" wx:key="id" bindtap="tab" data-id="{{item.id}}" class="{{noteTab===item.id?'active':''}}"><text>{{item.name}}</text><text wx:if="{{item.unread}}" class="unread-badge">{{item.unread}}</text></button></view>
<view class="inbox-batch"><button hover-class="none" bindtap="allNotes">{{allNotes?'取消全选':'全选本栏'}}</button><text>已选 {{selectedNotes.length}} 条</text><button hover-class="none" class="danger-copy" bindtap="deleteNotes" disabled="{{!selectedNotes.length}}">批量删除</button></view>
<view wx:if="{{error}}" class="error-tip" bindtap="retry">{{error}}</view>
<scroll-view scroll-y class="inbox-scroll"><checkbox-group bindchange="selectNotes">
<view wx:for="{{visibleNotes}}" wx:key="id" class="inbox-note {{item.read_at?'is-read':''}}"><view class="inbox-note-top"><checkbox value="{{item.id}}" checked="{{util.contains(selectedNotes,item.id)}}" color="#a66d48"/><text class="grow">{{item.date}}</text><text wx:if="{{!item.read_at}}" class="unread-mark">未读</text><button hover-class="none" class="note-delete" data-id="{{item.id}}" bindtap="deleteNotes">删除</button></view>
<button hover-class="none" class="note-open" data-id="{{item.id}}" bindtap="notification"><view class="note-body">{{item.body}}</view><view class="note-meal">{{item.meal}}</view><view wx:if="{{item.pictures.length}}" class="note-dishes"><view wx:for="{{item.pictures}}" wx:for-item="dish" wx:key="name"><image src="{{dish.cover}}" mode="aspectFill"/><text>{{dish.name}}</text></view></view><view class="note-bottom"><text>{{item.status || '小家来信'}}</text><text>查看详情 ›</text></view></button></view>
</checkbox-group><view wx:if="{{!visibleNotes.length}}" class="inbox-empty"><g-icon name="envelope" size="52"/><view>这一栏还没有来信</view><text>新消息会安静地收在这里</text></view></scroll-view>
</view></g-shell>
