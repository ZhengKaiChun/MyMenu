<view wx:if="{{visible}}" class="modal-mask">
  <view class="modal">
    <view class="h3">让小家，也保护好你</view>
    <view class="muted" style="margin: 18px 0">
      选择头像、上传菜品图片等功能，需要你主动授权。请先阅读
      <button class="text-btn" bindtap="contract">《{{contract}}》</button>
      ，不同意也可以继续使用其他功能。
    </view>
    <view class="row">
      <button class="btn secondary" bindtap="decline">暂不授权</button>
      <button
        class="btn"
        id="privacy-agree"
        open-type="agreePrivacyAuthorization"
        bindagreeprivacyauthorization="agree"
      >
        阅读并同意
      </button>
    </view>
  </view>
</view>
