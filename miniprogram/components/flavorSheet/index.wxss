.flavor-mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 999;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  background: #35291f79;
}
.flavor-sheet {
  width: 100%;
  max-height: 76vh;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  padding: 0 18px calc(14px + env(safe-area-inset-bottom));
  border-radius: 22px 22px 0 0;
  background: #fffaf0;
  box-shadow: 0 -8px 28px #3a261b30;
}
.flavor-handle {
  width: 36px;
  height: 4px;
  margin: 8px auto 11px;
  border-radius: 4px;
  background: #d9c8b2;
  flex: none;
}
.flavor-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 12px;
  padding: 0 2px 11px;
  border-bottom: 1px dashed #dac9b2;
  flex: none;
}
.flavor-head > view {
  display: flex;
  flex-direction: column;
  gap: 1px;
  min-width: 0;
}
.flavor-kicker {
  font-size: 9px;
  letter-spacing: 2px;
  color: #b3936c;
}
.flavor-title {
  font-size: 19px;
  font-weight: 700;
  line-height: 1.45;
  color: #573a2e;
}
.flavor-dish {
  font-size: 11px;
  color: #a38469;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.flavor-close {
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 29px;
  height: 29px;
  margin: 4px 0 0;
  padding: 0;
  border-radius: 50%;
  background: #f1e5d3;
  color: #8d7059;
  font-size: 20px;
  line-height: 1;
}
.flavor-scroll {
  flex: 1;
  min-height: 0;
  max-height: 52vh;
}
.flavor-group {
  margin: 12px 0;
  padding: 11px;
  border: 1px solid #eadbc4;
  border-radius: 17px 17px 8px 17px;
  background: #fffcf6;
  box-shadow: 0 2px 0 #eee3d2;
}
.flavor-group-head {
  display: flex;
  align-items: center;
  gap: 7px;
  margin-bottom: 9px;
}
.flavor-index {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 19px;
  height: 19px;
  flex: none;
  border-radius: 50%;
  background: #b76a4d;
  color: #fff9ed;
  font-size: 10px;
}
.flavor-group-title {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 14px;
  font-weight: 700;
  color: #5c4134;
}
.flavor-mode {
  flex: none;
  padding: 3px 7px;
  border-radius: 8px;
  background: #f3e7cf;
  color: #95724e;
  font-size: 10px;
}
.flavor-choices {
  display: flex;
  flex-wrap: wrap;
  gap: 7px;
}
.flavor-choice {
  display: flex;
  align-items: center;
  gap: 7px;
  box-sizing: border-box;
  width: calc(50% - 4px);
  min-height: 37px;
  margin: 0;
  padding: 7px 9px;
  border: 1px solid #e7d8c3;
  border-radius: 11px;
  background: #f8f1e6;
  color: #765e4b;
  text-align: left;
  font-size: 11px;
  line-height: 1.4;
}
.flavor-choice.selected {
  border-color: #bd866b;
  background: #f6e2d5;
  color: #75412f;
}
.choice-mark {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 17px;
  height: 17px;
  flex: none;
  border: 1px solid #cdbba5;
  border-radius: 50%;
  font-size: 10px;
  line-height: 1;
}
.selected .choice-mark {
  border-color: #bd765c;
  background: #be765b;
  color: #fffaf2;
}
.choice-label {
  flex: 1;
  min-width: 0;
  white-space: normal;
  word-break: break-all;
}
.flavor-footer {
  flex: none;
  padding-top: 10px;
  border-top: 1px dashed #e3d5c0;
}
.flavor-footer > text {
  display: block;
  margin-bottom: 8px;
  text-align: center;
  font-size: 10px;
  color: #9b826c;
}
.flavor-confirm {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 44px;
  margin: 0;
  padding: 0;
  border-radius: 13px;
  background: #5b392e;
  color: #fff9ed;
  font-size: 14px;
  font-weight: 700;
  letter-spacing: 0.5px;
}
.flavor-sheet button::after {
  border: 0;
}
