.dialog-backdrop {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 999;
  background: rgba(54, 37, 29, 0.38);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 25px;
  box-sizing: border-box;
}
.dialog-paper {
  width: 100%;
  max-width: 350px;
  box-sizing: border-box;
  border: 1.5px solid #bda077;
  border-radius: 9px 18px 7px 14px;
  padding: 23px 20px 20px;
  background: repeating-linear-gradient(0deg, #fff9ec 0 30px, #f0e7d3 30px 31px);
  box-shadow: 4px 5px 0 #dbc8a8;
  position: relative;
  color: #60432d;
}
.postmark {
  font-size: 10px;
  color: #a78a65;
  letter-spacing: 1px;
  margin-bottom: 15px;
}
.title {
  font-size: 22px;
  line-height: 1.5;
  font-weight: 700;
  margin-bottom: 15px;
}
.content {
  display: block;
  white-space: pre-wrap;
  font-size: 13px;
  line-height: 1.9;
  color: #947556;
}
.field {
  box-sizing: border-box;
  width: 100%;
  height: 49px;
  border: 1px solid #d6bc98;
  border-radius: 11px;
  padding: 10px 12px;
  background: #fffdf5;
  font-size: 14px;
  color: #60432d;
}
.actions {
  display: flex;
  gap: 10px;
  margin-top: 23px;
}
.actions button {
  flex: 1;
  width: 0;
  margin: 0;
  padding: 12px 6px;
  min-height: 46px;
  box-sizing: border-box;
  border-radius: 13px;
  font-size: 13px;
  line-height: 1.6;
}
.actions button::after {
  border: 0;
}
.primary {
  background: #4b3026;
  color: #fff7e7;
}
.secondary {
  background: #f0e2cc;
  color: #8b6747;
}
