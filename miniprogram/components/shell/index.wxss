.shell {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #fffcf6;
}
.nav {
  flex-shrink: 0;
  padding-left: 22px;
  padding-right: 108px;
  background: #fffcf6;
  box-sizing: border-box;
}
.nav-inner {
  display: flex;
  align-items: center;
  gap: 9px;
}
.back {
  font-size: 30px;
  width: 18px;
  margin: 0;
  padding: 0;
  color: #64452e;
}
.nav-title {
  font-size: 15px;
  font-weight: 700;
  color: #49352a;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.shell-body {
  flex: 1;
  min-height: 0;
  overflow: hidden;
}
.shell-dock:empty,
.shell-tabs:empty {
  display: none;
}
.shell-dock {
  flex-shrink: 0;
}
.shell-tabs {
  flex-shrink: 0;
}

.nav-inner {
  gap: 8px;
}
.back {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 28px !important;
  height: 40px;
  min-width: 28px;
  line-height: 1;
  margin-left: -7px !important;
  flex: none;
}
.back-chevron {
  width: 9px;
  height: 9px;
  border-left: 2px solid #64452e;
  border-bottom: 2px solid #64452e;
  transform: rotate(45deg);
  margin-left: 5px;
}
.nav-title {
  display: flex;
  align-items: center;
  height: 40px;
  line-height: 20px;
}
